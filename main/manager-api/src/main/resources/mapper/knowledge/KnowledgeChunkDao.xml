<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="xiaozhi.modules.knowledge.dao.KnowledgeChunkDao">
    <resultMap id="BaseResultMap" type="xiaozhi.modules.knowledge.entity.KnowledgeChunkEntity">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="datasetId" column="dataset_id" jdbcType="VARCHAR"/>
        <result property="documentId" column="document_id" jdbcType="VARCHAR"/>
        <result property="chunkId" column="chunk_id" jdbcType="VARCHAR"/>
        <result property="content" column="content" jdbcType="LONGVARCHAR"/>
        <result property="question" column="question" jdbcType="LONGVARCHAR"/>
        <result property="answer" column="answer" jdbcType="LONGVARCHAR"/>
        <result property="sortOrder" column="sort_order" jdbcType="INTEGER"/>
        <result property="tokenCount" column="token_count" jdbcType="BIGINT"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
        <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectRetrievalCandidates" resultMap="BaseResultMap">
        SELECT
            c.id,
            c.dataset_id,
            c.document_id,
            c.chunk_id,
            c.content,
            c.question,
            c.answer,
            c.sort_order,
            c.token_count,
            c.created_at,
            c.updated_at
        FROM ai_rag_knowledge_chunk c
        INNER JOIN ai_rag_knowledge_document d
            ON d.dataset_id = c.dataset_id
            AND d.document_id = c.document_id
            AND COALESCE(d.enabled, 1) = 1
        WHERE c.dataset_id IN
        <foreach collection="datasetIds" item="datasetId" open="(" separator="," close=")">
            #{datasetId}
        </foreach>
        <if test="documentIds != null and documentIds.size() > 0">
            AND c.document_id IN
            <foreach collection="documentIds" item="documentId" open="(" separator="," close=")">
                #{documentId}
            </foreach>
        </if>
        <choose>
            <when test="fulltextQuery != null and fulltextQuery != ''">
                AND (
                    MATCH(c.content, c.question, c.answer) AGAINST(#{fulltextQuery} IN BOOLEAN MODE)
                )
            </when>
            <when test="terms != null and terms.size() > 0">
                AND
                <foreach collection="terms" item="term" open="(" separator=" OR " close=")">
                    INSTR(c.content, #{term}) > 0
                    OR INSTR(c.question, #{term}) > 0
                    OR INSTR(c.answer, #{term}) > 0
                </foreach>
            </when>
        </choose>
        ORDER BY
        <if test="fulltextQuery != null and fulltextQuery != ''">
            MATCH(c.content, c.question, c.answer) AGAINST(#{fulltextQuery} IN BOOLEAN MODE) DESC,
        </if>
            c.sort_order ASC,
            c.id ASC
        LIMIT #{limit}
    </select>

    <select id="selectIndexableChunks" resultMap="BaseResultMap">
        SELECT
            c.id,
            c.dataset_id,
            c.document_id,
            c.chunk_id,
            c.content,
            c.question,
            c.answer,
            c.sort_order,
            c.token_count,
            c.created_at,
            c.updated_at
        FROM ai_rag_knowledge_chunk c
        INNER JOIN ai_rag_knowledge_document d
            ON d.dataset_id = c.dataset_id
            AND d.document_id = c.document_id
            AND COALESCE(d.enabled, 1) = 1
            AND d.run = 'DONE'
        WHERE c.dataset_id IN
        <foreach collection="datasetIds" item="datasetId" open="(" separator="," close=")">
            #{datasetId}
        </foreach>
        <if test="documentIds != null and documentIds.size() > 0">
            AND c.document_id IN
            <foreach collection="documentIds" item="documentId" open="(" separator="," close=")">
                #{documentId}
            </foreach>
        </if>
        ORDER BY c.dataset_id ASC, c.document_id ASC, c.sort_order ASC, c.id ASC
    </select>
</mapper>
