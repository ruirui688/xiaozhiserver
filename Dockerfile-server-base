# Dockerfile-server-base
# 基础镜像，包含系统依赖和Python包
# For production, pin to digest: FROM python:3.10-slim@sha256:...
ARG PYTHON_BASE_IMAGE=python:3.10-slim
FROM ${PYTHON_BASE_IMAGE}

ARG DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
ARG DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
ARG SERVER_REQUIREMENTS=main/xiaozhi-server/requirements-docker.txt
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com
ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# 安装系统依赖
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i \
            -e "s#http://deb.debian.org/debian-security#${DEBIAN_SECURITY_MIRROR}#g" \
            -e "s#http://deb.debian.org/debian#${DEBIAN_MIRROR}#g" \
            /etc/apt/sources.list.d/debian.sources; \
    elif [ -f /etc/apt/sources.list ]; then \
        sed -i \
            -e "s#http://deb.debian.org/debian-security#${DEBIAN_SECURITY_MIRROR}#g" \
            -e "s#http://deb.debian.org/debian#${DEBIAN_MIRROR}#g" \
            /etc/apt/sources.list; \
    fi; \
    apt-get update && \
    apt-get install -y --no-install-recommends libopus0 ffmpeg locales && \
    sed -i '/zh_CN.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 配置pip镜像源并设置超时和重试
RUN pip config set global.index-url "$PIP_INDEX_URL" && \
    if [ -n "$PIP_TRUSTED_HOST" ]; then pip config set global.trusted-host "$PIP_TRUSTED_HOST"; fi && \
    pip config set global.timeout 120 && \
    pip config set install.retries 5

# 设置环境变量以确保正确的字符编码
ENV LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    PYTHONIOENCODING=utf-8

WORKDIR /opt/xiaozhi-esp32-server

# 复制requirements.txt
COPY ${SERVER_REQUIREMENTS} requirements.txt

RUN if [ -n "$PYTORCH_INDEX_URL" ]; then \
      sed -i "s#^--extra-index-url https://download.pytorch.org/whl/cpu#--extra-index-url ${PYTORCH_INDEX_URL}#" requirements.txt; \
    fi

# 安装Python依赖。BuildKit cache mount lets interrupted wheel downloads be
# reused by the next build attempt without baking pip cache into the image.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt --default-timeout=120 --retries 5

# Create non-root user for security
RUN groupadd -r xiaozhi && useradd -r -g xiaozhi -d /opt/xiaozhi-esp32-server xiaozhi && \
    chown -R xiaozhi:xiaozhi /opt/xiaozhi-esp32-server
USER xiaozhi
