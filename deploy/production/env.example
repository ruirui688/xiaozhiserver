XIAOZHI_DEPLOY_MODE=pull
XIAOZHI_SERVER_IMAGE_REPOSITORY=crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/xiaozhi-server
XIAOZHI_MANAGER_API_IMAGE_REPOSITORY=crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/xiaozhi-manager-api
XIAOZHI_MANAGER_WEB_IMAGE_REPOSITORY=crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/xiaozhi-manager-web
XIAOZHI_MAINTENANCE_AGENT_IMAGE_REPOSITORY=crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/xiaozhi-maintenance-agent
XIAOZHI_MYSQL_IMAGE=crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/mysql:8.4
XIAOZHI_REDIS_IMAGE=crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/redis:8.0
# Public HTTPS entry used by browsers, ESP32 devices, and WeChat mini programs.
# Set these after Nginx or SLB terminates TLS on the production server.
XIAOZHI_PUBLIC_DOMAIN=yh.wejoy.link
XIAOZHI_PUBLIC_BASE_URL=https://yh.wejoy.link
XIAOZHI_CORS_ORIGINS=https://yh.wejoy.link
# REQUIRED: Set a strong MySQL root password (no default, will fail to start if unset)
# XIAOZHI_MYSQL_ROOT_PASSWORD=your-strong-password-here
# REQUIRED: Set a strong Redis password (no default, will fail to start if unset)
# XIAOZHI_REDIS_PASSWORD=your-strong-redis-password-here
XIAOZHI_SERVER_HTTP_BASE_URL=http://xiaozhi-esp32-server:8003
# Liquibase uses a dedicated connection. 0 disables the JDBC read timeout so
# large, one-time migrations cannot leave a stale lock after 30 seconds.
XIAOZHI_LIQUIBASE_SOCKET_TIMEOUT_MS=0
# Upgrade waits for the manager API port to become ready, including migrations.
XIAOZHI_MANAGER_API_STARTUP_TIMEOUT_SECONDS=900
# Legacy Harness settings are retained for compatibility; the production Compose no longer starts this service.
# Do not enable it with shared model keys: the legacy execution path has not adopted platform admission.
# The gateway scopes the native Console under the existing manager origin.
XIAOZHI_MAINTENANCE_FRAME_ANCESTORS=https://yh.wejoy.link
# OPS login currently needs only username/password. These flags do not change
# user login, enrollment or identity recovery checks. Retain existing TOTP seeds.
OPS_LOGIN_MFA_REQUIRED=false
OPS_LOGIN_CAPTCHA_REQUIRED=false
# Optional read-only supplier billing. Never copy real credentials into this template.
XIAOZHI_BILLING_VOLCENGINE_ENABLED=false
XIAOZHI_BILLING_VOLCENGINE_ACCESS_KEY=
XIAOZHI_BILLING_VOLCENGINE_SECRET_KEY=
XIAOZHI_BILLING_VOLCENGINE_ACCOUNT_REF=
XIAOZHI_BILLING_VOLCENGINE_REGION=cn-north-1
# Speech resource packs use a separate read-only API; runtime speech API keys cannot authorize it.
XIAOZHI_BILLING_VOLCENGINE_SPEECH_PROJECT=
# Comma-separated resource-pack service IDs verified in the speech console; no wildcard or assumed inference-ID mapping.
XIAOZHI_BILLING_VOLCENGINE_SPEECH_RESOURCE_IDS=
# Dedicated finance credential for the fixed official balance endpoint; never assigned to tenants.
XIAOZHI_BILLING_DEEPSEEK_API_KEY=
XIAOZHI_BILLING_DEEPSEEK_ACCOUNT_REF=
# Registration trial credit. Keep disabled until the issuance pool has a balance,
# otherwise new accounts are created usable but uncredited. Changing the amount
# requires a new policy id; a user is never granted a second trial.
XIAOZHI_PLATFORM_TRIAL_ENABLED=false
XIAOZHI_PLATFORM_TRIAL_AMOUNT=0
XIAOZHI_PLATFORM_TRIAL_POLICY=trial-v1
# 0 means unlimited trial users; otherwise cap the total number of granted users.
XIAOZHI_PLATFORM_TRIAL_MAX_USERS=0
# Hosted-key waterline. With one key per user this is the only early warning before
# new registrations start waiting for credentials. 0 disables the alert.
XIAOZHI_PLATFORM_CREDENTIAL_MIN_INVENTORY=0
