#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "${XIAOZHI_RELEASE_ASSETS_RESOLVED:-false}" != "true" ]]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  exec "$SCRIPT_DIR/upgrade" "$@"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEPLOY_USER="${XIAOZHI_DEPLOY_USER:-${SUDO_USER:-${USER:-$(id -un)}}}"
DEPLOY_HOME="${XIAOZHI_DEPLOY_HOME:-}"
if [[ -z "$DEPLOY_HOME" && "$DEPLOY_USER" != "root" ]]; then
  DEPLOY_HOME="$(getent passwd "$DEPLOY_USER" 2>/dev/null | cut -d: -f6 || true)"
fi
DEPLOY_HOME="${DEPLOY_HOME:-${HOME:-/root}}"
DATA_DIR="${DATA_DIR:-${INSTALL_DIR:-$DEPLOY_HOME/xiaozhi-data}}"
UPGRADE_LAUNCHER_PATH="${XIAOZHI_UPGRADE_LAUNCHER_PATH:-$DEPLOY_HOME/xiaozhi-upgrade}"
UPGRADE_RESOLVER_PATH="${XIAOZHI_UPGRADE_RESOLVER_PATH:-$DATA_DIR/bin/xiaozhi-upgrade-resolver}"
UPGRADE_LAUNCHER_DISPLAY="$UPGRADE_LAUNCHER_PATH"
if [[ "$UPGRADE_LAUNCHER_PATH" == "$DEPLOY_HOME/xiaozhi-upgrade" ]]; then
  UPGRADE_LAUNCHER_DISPLAY="~/xiaozhi-upgrade"
fi

DOCKER_CMD=(docker)
DOCKER_CONFIG_DISPLAY="${DOCKER_CONFIG:-${HOME:-$DEPLOY_HOME}/.docker}"

configure_docker_command() {
  if docker info >/dev/null 2>&1; then
    DOCKER_CMD=(docker)
    DOCKER_CONFIG_DISPLAY="${DOCKER_CONFIG:-${HOME:-$DEPLOY_HOME}/.docker}"
    return
  fi

  if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    DOCKER_CMD=(docker)
    DOCKER_CONFIG_DISPLAY="${DOCKER_CONFIG:-${HOME:-/root}/.docker}"
    return
  fi

  if ! command -v sudo >/dev/null 2>&1; then
    echo "Docker daemon is not reachable by the current user, and sudo is not available." >&2
    exit 1
  fi

  DOCKER_CMD=(sudo docker)
  DOCKER_CONFIG_DISPLAY="/root/.docker"
}

docker_cmd() {
  "${DOCKER_CMD[@]}" "$@"
}

generate_mysql_password() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 32 | tr -d '\n'
    return
  fi
  od -An -N24 -tx1 /dev/urandom | tr -d ' \n'
}

DEFAULT_SERVER_IMAGE_REPOSITORY="crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/xiaozhi-server"
DEFAULT_MANAGER_API_IMAGE_REPOSITORY="crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/xiaozhi-manager-api"
DEFAULT_MANAGER_WEB_IMAGE_REPOSITORY="crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/xiaozhi-manager-web"
DEFAULT_MYSQL_IMAGE="crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/mysql:8.4"
DEFAULT_REDIS_IMAGE="crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/redis:8.0"
DEFAULT_SERVER_HTTP_BASE_URL="http://xiaozhi-esp32-server:8003"
VERSION="${VERSION:-latest}"

format_duration() {
  local total="${1:-0}"
  printf "%02d:%02d" "$((total / 60))" "$((total % 60))"
}

run_step() {
  local label="$1"
  shift
  local start_ts end_ts elapsed log_file
  log_file="$(mktemp -t xiaozhi-install-step.XXXXXX.log)"
  start_ts="$(date +%s)"
  printf "  %-34s" "$label"
  if "$@" >"$log_file" 2>&1; then
    end_ts="$(date +%s)"
    elapsed=$((end_ts - start_ts))
    printf "OK   %s\n" "$(format_duration "$elapsed")"
    rm -f "$log_file"
    return 0
  fi
  end_ts="$(date +%s)"
  elapsed=$((end_ts - start_ts))
  printf "FAIL %s\n" "$(format_duration "$elapsed")"
  echo "ERROR: $label failed. Last output:" >&2
  tail -40 "$log_file" >&2
  rm -f "$log_file"
  return 1
}

install_upgrade_command() {
  local launcher_dir resolver_dir launcher_tmp resolver_tmp
  launcher_dir="$(dirname "$UPGRADE_LAUNCHER_PATH")"
  resolver_dir="$(dirname "$UPGRADE_RESOLVER_PATH")"
  launcher_tmp="${UPGRADE_LAUNCHER_PATH}.tmp.$$"
  resolver_tmp="${UPGRADE_RESOLVER_PATH}.tmp.$$"

  mkdir -p "$launcher_dir" "$resolver_dir"
  rm -f "$launcher_tmp" "$resolver_tmp"

  install -m 0755 "$SCRIPT_DIR/upgrade" "$resolver_tmp"
  mv -f "$resolver_tmp" "$UPGRADE_RESOLVER_PATH"

  {
    echo '#!/usr/bin/env bash'
    echo 'set -Eeuo pipefail'
    echo ''
    echo '# Managed by the xiaozhi production release. Do not edit this file manually.'
    echo 'if [[ -z "${DATA_DIR:-}" ]]; then'
    printf '  export DATA_DIR=%q\n' "$DATA_DIR"
    echo 'fi'
    printf 'exec %q "$@"\n' "$UPGRADE_RESOLVER_PATH"
  } >"$launcher_tmp"
  chmod 0755 "$launcher_tmp"
  mv -f "$launcher_tmp" "$UPGRADE_LAUNCHER_PATH"
}

short_image_name() {
  local image="$1"
  image="${image##*/}"
  printf "%s" "$image"
}

container_image() {
  local container="$1"
  docker_cmd inspect --format='{{.Config.Image}}' "$container" 2>/dev/null || printf "-"
}

read_existing_env() {
  local key="$1"
  local env_file="$DATA_DIR/.env"
  [[ -f "$env_file" ]] || return 0
  awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$env_file"
}

DEPLOY_ASSETS_IMAGE_REPOSITORY="${DEPLOY_ASSETS_IMAGE_REPOSITORY:-$(read_existing_env XIAOZHI_DEPLOY_ASSETS_IMAGE_REPOSITORY)}"
DEPLOY_ASSETS_IMAGE_REPOSITORY="${DEPLOY_ASSETS_IMAGE_REPOSITORY:-crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/xiaozhi-deploy-assets}"
RELEASE_ASSETS_IMAGE="${RELEASE_ASSETS_IMAGE:-$DEPLOY_ASSETS_IMAGE_REPOSITORY:$VERSION}"
RELEASE_SOURCE_COMMIT="${RELEASE_SOURCE_COMMIT:-unknown}"
RELEASE_CONTRACT_VERSION="${RELEASE_CONTRACT_VERSION:-unknown}"

write_runtime_env() {
  cat >"$DATA_DIR/.env" <<EOF
XIAOZHI_DEPLOY_MODE=$DEPLOY_MODE
XIAOZHI_DEPLOY_VERSION=$VERSION
XIAOZHI_DEPLOY_ASSETS_IMAGE_REPOSITORY=$DEPLOY_ASSETS_IMAGE_REPOSITORY
XIAOZHI_DEPLOY_ASSETS_IMAGE=$RELEASE_ASSETS_IMAGE
XIAOZHI_DEPLOY_SOURCE_COMMIT=$RELEASE_SOURCE_COMMIT
XIAOZHI_RELEASE_CONTRACT_VERSION=$RELEASE_CONTRACT_VERSION
XIAOZHI_SERVER_IMAGE_REPOSITORY=$SERVER_IMAGE_REPOSITORY
XIAOZHI_MANAGER_API_IMAGE_REPOSITORY=$MANAGER_API_IMAGE_REPOSITORY
XIAOZHI_MANAGER_WEB_IMAGE_REPOSITORY=$MANAGER_WEB_IMAGE_REPOSITORY
XIAOZHI_MYSQL_IMAGE=$MYSQL_IMAGE
XIAOZHI_REDIS_IMAGE=$REDIS_IMAGE
XIAOZHI_PUBLIC_DOMAIN=$PUBLIC_DOMAIN
XIAOZHI_PUBLIC_BASE_URL=$PUBLIC_BASE_URL
XIAOZHI_CORS_ORIGINS=$CORS_ORIGINS
XIAOZHI_MYSQL_ROOT_PASSWORD=$MYSQL_ROOT_PASSWORD
XIAOZHI_CREDENTIAL_ENCRYPTION_KEY=$CREDENTIAL_ENCRYPTION_KEY
XIAOZHI_SERVER_HTTP_BASE_URL=$SERVER_HTTP_BASE_URL
XIAOZHI_SERVER_CPUS=$SERVER_CPUS
XIAOZHI_SERVER_MEM_LIMIT=$SERVER_MEM_LIMIT
XIAOZHI_SERVER_MEMSWAP_LIMIT=$SERVER_MEMSWAP_LIMIT
XIAOZHI_SERVER_PIDS_LIMIT=$SERVER_PIDS_LIMIT
XIAOZHI_FUNASR_THREADS=$FUNASR_THREADS
XIAOZHI_MANAGER_API_CPUS=$MANAGER_API_CPUS
XIAOZHI_MANAGER_API_MEM_LIMIT=$MANAGER_API_MEM_LIMIT
XIAOZHI_MANAGER_API_MEMSWAP_LIMIT=$MANAGER_API_MEMSWAP_LIMIT
XIAOZHI_MANAGER_API_PIDS_LIMIT=$MANAGER_API_PIDS_LIMIT
XIAOZHI_MANAGER_API_JAVA_TOOL_OPTIONS=$MANAGER_API_JAVA_TOOL_OPTIONS
XIAOZHI_LIQUIBASE_SOCKET_TIMEOUT_MS=$LIQUIBASE_SOCKET_TIMEOUT_MS
XIAOZHI_MANAGER_API_STARTUP_TIMEOUT_SECONDS=$MANAGER_API_STARTUP_TIMEOUT_SECONDS
XIAOZHI_MANAGER_WEB_CPUS=$MANAGER_WEB_CPUS
XIAOZHI_MANAGER_WEB_MEM_LIMIT=$MANAGER_WEB_MEM_LIMIT
XIAOZHI_MANAGER_WEB_MEMSWAP_LIMIT=$MANAGER_WEB_MEMSWAP_LIMIT
XIAOZHI_MANAGER_WEB_PIDS_LIMIT=$MANAGER_WEB_PIDS_LIMIT
XIAOZHI_MYSQL_CPUS=$MYSQL_CPUS
XIAOZHI_MYSQL_MEM_LIMIT=$MYSQL_MEM_LIMIT
XIAOZHI_MYSQL_MEMSWAP_LIMIT=$MYSQL_MEMSWAP_LIMIT
XIAOZHI_MYSQL_PIDS_LIMIT=$MYSQL_PIDS_LIMIT
XIAOZHI_MYSQL_INNODB_BUFFER_POOL_SIZE=$MYSQL_INNODB_BUFFER_POOL_SIZE
XIAOZHI_MYSQL_MAX_CONNECTIONS=$MYSQL_MAX_CONNECTIONS
XIAOZHI_MYSQL_TABLE_OPEN_CACHE=$MYSQL_TABLE_OPEN_CACHE
XIAOZHI_MYSQL_PERFORMANCE_SCHEMA=$MYSQL_PERFORMANCE_SCHEMA
XIAOZHI_REDIS_CPUS=$REDIS_CPUS
XIAOZHI_REDIS_MEM_LIMIT=$REDIS_MEM_LIMIT
XIAOZHI_REDIS_MEMSWAP_LIMIT=$REDIS_MEMSWAP_LIMIT
XIAOZHI_REDIS_PIDS_LIMIT=$REDIS_PIDS_LIMIT
XIAOZHI_REDIS_MAXMEMORY=$REDIS_MAXMEMORY
XIAOZHI_REDIS_MAXMEMORY_POLICY=$REDIS_MAXMEMORY_POLICY
XIAOZHI_LOG_MAX_SIZE=$LOG_MAX_SIZE
XIAOZHI_LOG_MAX_FILE=$LOG_MAX_FILE
EOF
}

pull_images() {
  docker_cmd pull --quiet "$SERVER_IMAGE" >/dev/null
  docker_cmd pull --quiet "$MANAGER_API_IMAGE" >/dev/null
  docker_cmd pull --quiet "$MANAGER_WEB_IMAGE" >/dev/null
  docker_cmd pull --quiet "$MYSQL_IMAGE" >/dev/null
  docker_cmd pull --quiet "$REDIS_IMAGE" >/dev/null
}

fix_runtime_ownership() {
  docker_cmd run --rm --user 0 --entrypoint sh \
    -v "$DATA_DIR/data:/target" \
    "$SERVER_IMAGE" \
    -c "chown -R 999:999 /target && chmod 755 /target && if [ -f /target/.config.yaml ]; then chmod 644 /target/.config.yaml; fi" \
    >/dev/null

  docker_cmd run --rm --user 0 --entrypoint sh \
    -v "$DATA_DIR/uploadfile:/uploadfile" \
    -v "$DATA_DIR/music:/music" \
    "$SERVER_IMAGE" \
    -c "chown -R 100:101 /uploadfile /music && chmod 755 /uploadfile /music" \
    >/dev/null
}

ensure_private_config() {
  if [[ -f "$DATA_DIR/data/.config.yaml" ]]; then
    return
  fi
  if cp "$SCRIPT_DIR/config_from_api.yaml" "$DATA_DIR/data/.config.yaml" 2>/dev/null; then
    return
  fi

  docker_cmd run --rm --user 0 --entrypoint sh \
    -v "$SCRIPT_DIR/config_from_api.yaml:/tmp/config.yaml:ro" \
    -v "$DATA_DIR/data:/target" \
    "$SERVER_IMAGE" \
    -c "cp /tmp/config.yaml /target/.config.yaml" \
    >/dev/null
}

prepare_runtime_files() {
  cp "$SCRIPT_DIR/docker-compose.yml" "$DATA_DIR/docker-compose.yml"
  ensure_private_config
  write_runtime_env
  sed -i "s|:latest\$|:$VERSION|" "$DATA_DIR/docker-compose.yml"
  fix_runtime_ownership
}

start_services() {
  docker_cmd compose -f "$DATA_DIR/docker-compose.yml" --env-file "$DATA_DIR/.env" config >/dev/null
  docker_cmd compose -f "$DATA_DIR/docker-compose.yml" --env-file "$DATA_DIR/.env" up -d --quiet-pull >/dev/null
}

read_server_secret_from_db() {
  docker_cmd exec xiaozhi-esp32-server-db \
    mysql -uroot -p"$MYSQL_ROOT_PASSWORD" --batch --skip-column-names \
    xiaozhi_esp32_server \
    -e "SELECT param_value FROM sys_params WHERE param_code='server.secret' LIMIT 1;" \
    2>/dev/null | tr -d '\r' | tail -n 1
}

sync_manager_api_secret() {
  local config_file="$DATA_DIR/data/.config.yaml"
  local server_secret tmp_file

  server_secret="$(read_server_secret_from_db)"
  if [[ -z "$server_secret" || "$server_secret" == "null" || "$server_secret" == *" "* ]]; then
    echo "Could not read a usable server.secret from manager-api database." >&2
    return 1
  fi

  tmp_file="$(mktemp -t xiaozhi-config.XXXXXX.yaml)"
  awk -v secret="$server_secret" '
    BEGIN { in_manager = 0; written = 0 }
    /^manager-api:[[:space:]]*$/ {
      in_manager = 1
      print
      next
    }
    /^[^[:space:]#][^:]*:[[:space:]]*/ && $0 !~ /^manager-api:[[:space:]]*$/ {
      if (in_manager && !written) {
        print "  secret: " secret
        written = 1
      }
      in_manager = 0
    }
    in_manager && /^[[:space:]]+secret:[[:space:]]*/ {
      print "  secret: " secret
      written = 1
      next
    }
    { print }
    END {
      if (in_manager && !written) {
        print "  secret: " secret
      }
    }
  ' "$config_file" >"$tmp_file"
  docker_cmd run --rm --user 0 --entrypoint sh \
    -v "$tmp_file:/tmp/new-config.yaml:ro" \
    -v "$DATA_DIR/data:/target" \
    "$SERVER_IMAGE" \
    -c "cat /tmp/new-config.yaml > /target/.config.yaml && chown 999:999 /target/.config.yaml && chmod 600 /target/.config.yaml" \
    >/dev/null
  rm -f "$tmp_file"
}

restart_server_service() {
  docker_cmd compose -f "$DATA_DIR/docker-compose.yml" --env-file "$DATA_DIR/.env" up -d --quiet-pull xiaozhi-esp32-server >/dev/null
}

wait_server_running() {
  local timeout="${1:-90}"
  local start_ts elapsed status restart_count stable_since last_restart_count
  start_ts="$(date +%s)"
  stable_since=0
  last_restart_count=""
  while true; do
    status="$(docker_cmd inspect --format='{{.State.Status}}' xiaozhi-esp32-server 2>/dev/null || echo "missing")"
    restart_count="$(docker_cmd inspect --format='{{.RestartCount}}' xiaozhi-esp32-server 2>/dev/null || echo "-1")"
    if [[ "$status" == "running" ]]; then
      if [[ "$restart_count" != "$last_restart_count" ]]; then
        last_restart_count="$restart_count"
        stable_since="$(date +%s)"
      elif [[ $(( $(date +%s) - stable_since )) -ge 10 ]]; then
        return 0
      fi
    else
      stable_since=0
    fi
    elapsed=$(( $(date +%s) - start_ts ))
    if [[ "$elapsed" -gt "$timeout" ]]; then
      echo "xiaozhi-server did not enter running state within ${timeout}s (status: $status)." >&2
      docker_cmd logs xiaozhi-esp32-server --tail 30 >&2 || true
      return 1
    fi
    sleep 1
  done
}

