#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA_DIR="${DATA_DIR:-${INSTALL_DIR:-/opt/xiaozhi-data}}"

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  exec sudo -E "$0" "$@"
fi

DEFAULT_SERVER_IMAGE_REPOSITORY="crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/xiaozhi-server"
DEFAULT_WEB_IMAGE_REPOSITORY="crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/xiaozhi-web"
DEFAULT_MYSQL_IMAGE="crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/mysql:8.4"
DEFAULT_REDIS_IMAGE="crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com/yihuixiaozhi/redis:8.0"
DEFAULT_SERVER_HTTP_BASE_URL="http://xiaozhi-esp32-server:8003"
VERSION="${VERSION:-latest}"

format_duration() {
  local total="${1:-0}"
  printf "%02d:%02d" "$((total / 60))" "$((total % 60))"
}

run_step() {
  local label="$1"
  shift
  local start_ts end_ts elapsed log_file
  log_file="$(mktemp -t xiaozhi-install-step.XXXXXX.log)"
  start_ts="$(date +%s)"
  printf "  %-34s" "$label"
  if "$@" >"$log_file" 2>&1; then
    end_ts="$(date +%s)"
    elapsed=$((end_ts - start_ts))
    printf "OK   %s\n" "$(format_duration "$elapsed")"
    rm -f "$log_file"
    return 0
  fi
  end_ts="$(date +%s)"
  elapsed=$((end_ts - start_ts))
  printf "FAIL %s\n" "$(format_duration "$elapsed")"
  echo "ERROR: $label failed. Last output:" >&2
  tail -40 "$log_file" >&2
  rm -f "$log_file"
  return 1
}

short_image_name() {
  local image="$1"
  image="${image##*/}"
  printf "%s" "$image"
}

container_image() {
  local container="$1"
  docker inspect --format='{{.Config.Image}}' "$container" 2>/dev/null || printf "-"
}

read_existing_env() {
  local key="$1"
  local env_file="$DATA_DIR/.env"
  [[ -f "$env_file" ]] || return 0
  awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$env_file"
}

write_runtime_env() {
  cat >"$DATA_DIR/.env" <<EOF
XIAOZHI_DEPLOY_MODE=$DEPLOY_MODE
XIAOZHI_DEPLOY_VERSION=$VERSION
XIAOZHI_SERVER_IMAGE_REPOSITORY=$SERVER_IMAGE_REPOSITORY
XIAOZHI_WEB_IMAGE_REPOSITORY=$WEB_IMAGE_REPOSITORY
XIAOZHI_MYSQL_IMAGE=$MYSQL_IMAGE
XIAOZHI_REDIS_IMAGE=$REDIS_IMAGE
XIAOZHI_MYSQL_ROOT_PASSWORD=$MYSQL_ROOT_PASSWORD
XIAOZHI_SERVER_HTTP_BASE_URL=$SERVER_HTTP_BASE_URL
XIAOZHI_SERVER_CPUS=$SERVER_CPUS
XIAOZHI_SERVER_MEM_LIMIT=$SERVER_MEM_LIMIT
XIAOZHI_SERVER_MEMSWAP_LIMIT=$SERVER_MEMSWAP_LIMIT
XIAOZHI_SERVER_PIDS_LIMIT=$SERVER_PIDS_LIMIT
XIAOZHI_FUNASR_THREADS=$FUNASR_THREADS
XIAOZHI_WEB_CPUS=$WEB_CPUS
XIAOZHI_WEB_MEM_LIMIT=$WEB_MEM_LIMIT
XIAOZHI_WEB_MEMSWAP_LIMIT=$WEB_MEMSWAP_LIMIT
XIAOZHI_WEB_PIDS_LIMIT=$WEB_PIDS_LIMIT
XIAOZHI_WEB_JAVA_TOOL_OPTIONS=$WEB_JAVA_TOOL_OPTIONS
XIAOZHI_MYSQL_CPUS=$MYSQL_CPUS
XIAOZHI_MYSQL_MEM_LIMIT=$MYSQL_MEM_LIMIT
XIAOZHI_MYSQL_MEMSWAP_LIMIT=$MYSQL_MEMSWAP_LIMIT
XIAOZHI_MYSQL_PIDS_LIMIT=$MYSQL_PIDS_LIMIT
XIAOZHI_MYSQL_INNODB_BUFFER_POOL_SIZE=$MYSQL_INNODB_BUFFER_POOL_SIZE
XIAOZHI_MYSQL_MAX_CONNECTIONS=$MYSQL_MAX_CONNECTIONS
XIAOZHI_MYSQL_TABLE_OPEN_CACHE=$MYSQL_TABLE_OPEN_CACHE
XIAOZHI_MYSQL_PERFORMANCE_SCHEMA=$MYSQL_PERFORMANCE_SCHEMA
XIAOZHI_REDIS_CPUS=$REDIS_CPUS
XIAOZHI_REDIS_MEM_LIMIT=$REDIS_MEM_LIMIT
XIAOZHI_REDIS_MEMSWAP_LIMIT=$REDIS_MEMSWAP_LIMIT
XIAOZHI_REDIS_PIDS_LIMIT=$REDIS_PIDS_LIMIT
XIAOZHI_REDIS_MAXMEMORY=$REDIS_MAXMEMORY
XIAOZHI_REDIS_MAXMEMORY_POLICY=$REDIS_MAXMEMORY_POLICY
XIAOZHI_LOG_MAX_SIZE=$LOG_MAX_SIZE
XIAOZHI_LOG_MAX_FILE=$LOG_MAX_FILE
EOF
}

pull_images() {
  docker pull --quiet "$SERVER_IMAGE" >/dev/null
  docker pull --quiet "$WEB_IMAGE" >/dev/null
  docker pull --quiet "$MYSQL_IMAGE" >/dev/null
  docker pull --quiet "$REDIS_IMAGE" >/dev/null
}

prepare_runtime_files() {
  cp "$SCRIPT_DIR/docker-compose.yml" "$DATA_DIR/docker-compose.yml"
  if [[ ! -f "$DATA_DIR/data/.config.yaml" ]]; then
    cp "$SCRIPT_DIR/config_from_api.yaml" "$DATA_DIR/data/.config.yaml"
  fi
  write_runtime_env
  sed -i "s|:latest\$|:$VERSION|" "$DATA_DIR/docker-compose.yml"
  # xiaozhi-server runs as 999:999 and writes data/.auth_key.
  chown -R 999:999 "$DATA_DIR/data"
  chmod 755 "$DATA_DIR/data"
  # manager-api/web runs as 100:101 and writes OTA firmware plus music uploads.
  chown -R 100:101 "$DATA_DIR/uploadfile" "$DATA_DIR/music"
  chmod 755 "$DATA_DIR/uploadfile" "$DATA_DIR/music"
  chmod 644 "$DATA_DIR/data/.config.yaml"
}

start_services() {
  docker compose -f "$DATA_DIR/docker-compose.yml" --env-file "$DATA_DIR/.env" config >/dev/null
  docker compose -f "$DATA_DIR/docker-compose.yml" --env-file "$DATA_DIR/.env" up -d --quiet-pull >/dev/null
}

read_server_secret_from_db() {
  docker exec xiaozhi-esp32-server-db \
    mysql -uroot -p"$MYSQL_ROOT_PASSWORD" --batch --skip-column-names \
    xiaozhi_esp32_server \
    -e "SELECT param_value FROM sys_params WHERE param_code='server.secret' LIMIT 1;" \
    2>/dev/null | tr -d '\r' | tail -n 1
}

sync_manager_api_secret() {
  local config_file="$DATA_DIR/data/.config.yaml"
  local server_secret tmp_file

  server_secret="$(read_server_secret_from_db)"
  if [[ -z "$server_secret" || "$server_secret" == "null" || "$server_secret" == *" "* ]]; then
    echo "Could not read a usable server.secret from manager-api database." >&2
    return 1
  fi

  tmp_file="$(mktemp -t xiaozhi-config.XXXXXX.yaml)"
  awk -v secret="$server_secret" '
    BEGIN { in_manager = 0; written = 0 }
    /^manager-api:[[:space:]]*$/ {
      in_manager = 1
      print
      next
    }
    /^[^[:space:]#][^:]*:[[:space:]]*/ && $0 !~ /^manager-api:[[:space:]]*$/ {
      if (in_manager && !written) {
        print "  secret: " secret
        written = 1
      }
      in_manager = 0
    }
    in_manager && /^[[:space:]]+secret:[[:space:]]*/ {
      print "  secret: " secret
      written = 1
      next
    }
    { print }
    END {
      if (in_manager && !written) {
        print "  secret: " secret
      }
    }
  ' "$config_file" >"$tmp_file"
  install -o 999 -g 999 -m 600 "$tmp_file" "$config_file"
  rm -f "$tmp_file"
}

restart_server_service() {
  docker compose -f "$DATA_DIR/docker-compose.yml" --env-file "$DATA_DIR/.env" up -d --quiet-pull xiaozhi-esp32-server >/dev/null
}

wait_server_running() {
  local timeout="${1:-90}"
  local start_ts elapsed status restart_count stable_since last_restart_count
  start_ts="$(date +%s)"
  stable_since=0
  last_restart_count=""
  while true; do
    status="$(docker inspect --format='{{.State.Status}}' xiaozhi-esp32-server 2>/dev/null || echo "missing")"
    restart_count="$(docker inspect --format='{{.RestartCount}}' xiaozhi-esp32-server 2>/dev/null || echo "-1")"
    if [[ "$status" == "running" ]]; then
      if [[ "$restart_count" != "$last_restart_count" ]]; then
        last_restart_count="$restart_count"
        stable_since="$(date +%s)"
      elif [[ $(( $(date +%s) - stable_since )) -ge 10 ]]; then
        return 0
      fi
    else
      stable_since=0
    fi
    elapsed=$(( $(date +%s) - start_ts ))
    if [[ "$elapsed" -gt "$timeout" ]]; then
      echo "xiaozhi-server did not enter running state within ${timeout}s (status: $status)." >&2
      docker logs xiaozhi-esp32-server --tail 30 >&2 || true
      return 1
    fi
    sleep 1
  done
}

DEPLOY_MODE="${DEPLOY_MODE:-$(read_existing_env XIAOZHI_DEPLOY_MODE)}"
DEPLOY_MODE="${DEPLOY_MODE:-pull}"
CURRENT_DEPLOY_VERSION="$(read_existing_env XIAOZHI_DEPLOY_VERSION)"
CURRENT_DEPLOY_VERSION="${CURRENT_DEPLOY_VERSION:-unknown}"
SERVER_IMAGE_REPOSITORY="${SERVER_IMAGE_REPOSITORY:-$(read_existing_env XIAOZHI_SERVER_IMAGE_REPOSITORY)}"
SERVER_IMAGE_REPOSITORY="${SERVER_IMAGE_REPOSITORY:-$DEFAULT_SERVER_IMAGE_REPOSITORY}"
WEB_IMAGE_REPOSITORY="${WEB_IMAGE_REPOSITORY:-$(read_existing_env XIAOZHI_WEB_IMAGE_REPOSITORY)}"
WEB_IMAGE_REPOSITORY="${WEB_IMAGE_REPOSITORY:-$DEFAULT_WEB_IMAGE_REPOSITORY}"
MYSQL_IMAGE="${MYSQL_IMAGE:-$(read_existing_env XIAOZHI_MYSQL_IMAGE)}"
MYSQL_IMAGE="${MYSQL_IMAGE:-$DEFAULT_MYSQL_IMAGE}"
REDIS_IMAGE="${REDIS_IMAGE:-$(read_existing_env XIAOZHI_REDIS_IMAGE)}"
REDIS_IMAGE="${REDIS_IMAGE:-$DEFAULT_REDIS_IMAGE}"
MYSQL_ROOT_PASSWORD="${MYSQL_ROOT_PASSWORD:-$(read_existing_env XIAOZHI_MYSQL_ROOT_PASSWORD)}"
MYSQL_ROOT_PASSWORD="${MYSQL_ROOT_PASSWORD:-123456}"
SERVER_HTTP_BASE_URL="${XIAOZHI_SERVER_HTTP_BASE_URL:-${SERVER_HTTP_BASE_URL:-}}"
SERVER_HTTP_BASE_URL="${SERVER_HTTP_BASE_URL:-$(read_existing_env XIAOZHI_SERVER_HTTP_BASE_URL)}"
SERVER_HTTP_BASE_URL="${SERVER_HTTP_BASE_URL:-$DEFAULT_SERVER_HTTP_BASE_URL}"
SERVER_CPUS="${XIAOZHI_SERVER_CPUS:-$(read_existing_env XIAOZHI_SERVER_CPUS)}"
SERVER_CPUS="${SERVER_CPUS:-1.00}"
SERVER_MEM_LIMIT="${XIAOZHI_SERVER_MEM_LIMIT:-$(read_existing_env XIAOZHI_SERVER_MEM_LIMIT)}"
SERVER_MEM_LIMIT="${SERVER_MEM_LIMIT:-2048m}"
SERVER_MEMSWAP_LIMIT="${XIAOZHI_SERVER_MEMSWAP_LIMIT:-$(read_existing_env XIAOZHI_SERVER_MEMSWAP_LIMIT)}"
SERVER_MEMSWAP_LIMIT="${SERVER_MEMSWAP_LIMIT:-$SERVER_MEM_LIMIT}"
SERVER_PIDS_LIMIT="${XIAOZHI_SERVER_PIDS_LIMIT:-$(read_existing_env XIAOZHI_SERVER_PIDS_LIMIT)}"
SERVER_PIDS_LIMIT="${SERVER_PIDS_LIMIT:-512}"
FUNASR_THREADS="${XIAOZHI_FUNASR_THREADS:-$(read_existing_env XIAOZHI_FUNASR_THREADS)}"
FUNASR_THREADS="${FUNASR_THREADS:-2}"
WEB_CPUS="${XIAOZHI_WEB_CPUS:-$(read_existing_env XIAOZHI_WEB_CPUS)}"
WEB_CPUS="${WEB_CPUS:-0.60}"
WEB_MEM_LIMIT="${XIAOZHI_WEB_MEM_LIMIT:-$(read_existing_env XIAOZHI_WEB_MEM_LIMIT)}"
WEB_MEM_LIMIT="${WEB_MEM_LIMIT:-1024m}"
WEB_MEMSWAP_LIMIT="${XIAOZHI_WEB_MEMSWAP_LIMIT:-$(read_existing_env XIAOZHI_WEB_MEMSWAP_LIMIT)}"
WEB_MEMSWAP_LIMIT="${WEB_MEMSWAP_LIMIT:-$WEB_MEM_LIMIT}"
WEB_PIDS_LIMIT="${XIAOZHI_WEB_PIDS_LIMIT:-$(read_existing_env XIAOZHI_WEB_PIDS_LIMIT)}"
WEB_PIDS_LIMIT="${WEB_PIDS_LIMIT:-512}"
WEB_JAVA_TOOL_OPTIONS="${XIAOZHI_WEB_JAVA_TOOL_OPTIONS:-$(read_existing_env XIAOZHI_WEB_JAVA_TOOL_OPTIONS)}"
WEB_JAVA_TOOL_OPTIONS="${WEB_JAVA_TOOL_OPTIONS:--XX:MaxRAMPercentage=60.0 -XX:InitialRAMPercentage=20.0 -XX:+ExitOnOutOfMemoryError}"
MYSQL_CPUS="${XIAOZHI_MYSQL_CPUS:-$(read_existing_env XIAOZHI_MYSQL_CPUS)}"
MYSQL_CPUS="${MYSQL_CPUS:-0.30}"
MYSQL_MEM_LIMIT="${XIAOZHI_MYSQL_MEM_LIMIT:-$(read_existing_env XIAOZHI_MYSQL_MEM_LIMIT)}"
MYSQL_MEM_LIMIT="${MYSQL_MEM_LIMIT:-768m}"
MYSQL_MEMSWAP_LIMIT="${XIAOZHI_MYSQL_MEMSWAP_LIMIT:-$(read_existing_env XIAOZHI_MYSQL_MEMSWAP_LIMIT)}"
MYSQL_MEMSWAP_LIMIT="${MYSQL_MEMSWAP_LIMIT:-$MYSQL_MEM_LIMIT}"
MYSQL_PIDS_LIMIT="${XIAOZHI_MYSQL_PIDS_LIMIT:-$(read_existing_env XIAOZHI_MYSQL_PIDS_LIMIT)}"
MYSQL_PIDS_LIMIT="${MYSQL_PIDS_LIMIT:-256}"
MYSQL_INNODB_BUFFER_POOL_SIZE="${XIAOZHI_MYSQL_INNODB_BUFFER_POOL_SIZE:-$(read_existing_env XIAOZHI_MYSQL_INNODB_BUFFER_POOL_SIZE)}"
MYSQL_INNODB_BUFFER_POOL_SIZE="${MYSQL_INNODB_BUFFER_POOL_SIZE:-192M}"
MYSQL_MAX_CONNECTIONS="${XIAOZHI_MYSQL_MAX_CONNECTIONS:-$(read_existing_env XIAOZHI_MYSQL_MAX_CONNECTIONS)}"
MYSQL_MAX_CONNECTIONS="${MYSQL_MAX_CONNECTIONS:-80}"
MYSQL_TABLE_OPEN_CACHE="${XIAOZHI_MYSQL_TABLE_OPEN_CACHE:-$(read_existing_env XIAOZHI_MYSQL_TABLE_OPEN_CACHE)}"
MYSQL_TABLE_OPEN_CACHE="${MYSQL_TABLE_OPEN_CACHE:-512}"
MYSQL_PERFORMANCE_SCHEMA="${XIAOZHI_MYSQL_PERFORMANCE_SCHEMA:-$(read_existing_env XIAOZHI_MYSQL_PERFORMANCE_SCHEMA)}"
MYSQL_PERFORMANCE_SCHEMA="${MYSQL_PERFORMANCE_SCHEMA:-OFF}"
REDIS_CPUS="${XIAOZHI_REDIS_CPUS:-$(read_existing_env XIAOZHI_REDIS_CPUS)}"
REDIS_CPUS="${REDIS_CPUS:-0.10}"
REDIS_MEM_LIMIT="${XIAOZHI_REDIS_MEM_LIMIT:-$(read_existing_env XIAOZHI_REDIS_MEM_LIMIT)}"
REDIS_MEM_LIMIT="${REDIS_MEM_LIMIT:-192m}"
REDIS_MEMSWAP_LIMIT="${XIAOZHI_REDIS_MEMSWAP_LIMIT:-$(read_existing_env XIAOZHI_REDIS_MEMSWAP_LIMIT)}"
REDIS_MEMSWAP_LIMIT="${REDIS_MEMSWAP_LIMIT:-$REDIS_MEM_LIMIT}"
REDIS_PIDS_LIMIT="${XIAOZHI_REDIS_PIDS_LIMIT:-$(read_existing_env XIAOZHI_REDIS_PIDS_LIMIT)}"
REDIS_PIDS_LIMIT="${REDIS_PIDS_LIMIT:-128}"
REDIS_MAXMEMORY="${XIAOZHI_REDIS_MAXMEMORY:-$(read_existing_env XIAOZHI_REDIS_MAXMEMORY)}"
REDIS_MAXMEMORY="${REDIS_MAXMEMORY:-128mb}"
REDIS_MAXMEMORY_POLICY="${XIAOZHI_REDIS_MAXMEMORY_POLICY:-$(read_existing_env XIAOZHI_REDIS_MAXMEMORY_POLICY)}"
REDIS_MAXMEMORY_POLICY="${REDIS_MAXMEMORY_POLICY:-allkeys-lru}"
LOG_MAX_SIZE="${XIAOZHI_LOG_MAX_SIZE:-$(read_existing_env XIAOZHI_LOG_MAX_SIZE)}"
LOG_MAX_SIZE="${LOG_MAX_SIZE:-50m}"
LOG_MAX_FILE="${XIAOZHI_LOG_MAX_FILE:-$(read_existing_env XIAOZHI_LOG_MAX_FILE)}"
LOG_MAX_FILE="${LOG_MAX_FILE:-3}"
case "$SERVER_HTTP_BASE_URL" in
  http://127.0.0.1:*|https://127.0.0.1:*|http://localhost:*|https://localhost:*)
    echo "Replacing loopback XIAOZHI_SERVER_HTTP_BASE_URL with Docker service URL: $DEFAULT_SERVER_HTTP_BASE_URL" >&2
    SERVER_HTTP_BASE_URL="$DEFAULT_SERVER_HTTP_BASE_URL"
    ;;
esac

if [[ "$DEPLOY_MODE" != "pull" ]]; then
  echo "Only DEPLOY_MODE=pull is supported for production deployment." >&2
  exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is not installed. Install Docker first, then rerun this script." >&2
  exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
  echo "Docker Compose plugin is not available. Install docker-compose-plugin first." >&2
  exit 1
fi

mkdir -p \
  "$DATA_DIR/data" \
  "$DATA_DIR/mysql/data" \
  "$DATA_DIR/redis/data" \
  "$DATA_DIR/music" \
  "$DATA_DIR/uploadfile"

SERVER_IMAGE="$SERVER_IMAGE_REPOSITORY:$VERSION"
WEB_IMAGE="$WEB_IMAGE_REPOSITORY:$VERSION"
VERSION_LABEL="$VERSION"
if [[ "$VERSION" == "latest" ]]; then
  VERSION_LABEL="latest (mutable)"
fi

echo "Production deploy"
printf "  %-10s %s\n" "version:" "$VERSION_LABEL"
printf "  %-10s %s\n" "current:" "$CURRENT_DEPLOY_VERSION"
if [[ -n "${DEPLOY_GIT_BRANCH:-}" ]]; then
  printf "  %-10s %s %s -> %s\n" "assets:" "$DEPLOY_GIT_BRANCH" "${DEPLOY_GIT_BEFORE:-unknown}" "${DEPLOY_GIT_AFTER:-unknown}"
fi
printf "  %-10s %s, %s\n" "images:" "$(short_image_name "$SERVER_IMAGE")" "$(short_image_name "$WEB_IMAGE")"
printf "  %-10s %s, %s\n" "runtime:" "$(short_image_name "$MYSQL_IMAGE")" "$(short_image_name "$REDIS_IMAGE")"
printf "  %-10s server=%s/%s web=%s/%s mysql=%s/%s redis=%s/%s\n" \
  "limits:" \
  "$SERVER_CPUS" "$SERVER_MEM_LIMIT" \
  "$WEB_CPUS" "$WEB_MEM_LIMIT" \
  "$MYSQL_CPUS" "$MYSQL_MEM_LIMIT" \
  "$REDIS_CPUS" "$REDIS_MEM_LIMIT"
printf "  %-10s %s\n" "data:" "$DATA_DIR"

echo ""
run_step "Pull images" pull_images
run_step "Prepare runtime files" prepare_runtime_files
run_step "Start services" start_services

_wait_manager_api_startup() {
  local timeout="${1:-180}"
  local start_ts
  start_ts="$(date +%s)"

  printf "  %-34s" "Wait manager-api startup"
  while true; do
    if docker logs xiaozhi-esp32-server-web 2>&1 | grep -q "Started AdminApplication in"; then
      local elapsed=$(( $(date +%s) - start_ts ))
      printf "OK   %s\n" "$(format_duration "$elapsed")"
      return 0
    fi
    local elapsed=$(( $(date +%s) - start_ts ))
    if [ "$elapsed" -gt "$timeout" ]; then
      printf "FAIL %s\n" "$(format_duration "$elapsed")"
      echo "ERROR: manager-api did not start within ${timeout}s." >&2
      echo "--- last 20 log lines ---" >&2
      docker logs xiaozhi-esp32-server-web --tail 20 >&2
      return 1
    fi
    sleep 1
  done
}

# Skip startup wait if container was already running before this deploy.
CONTAINER_STATUS=$(docker inspect --format='{{.State.Status}}' xiaozhi-esp32-server-web 2>/dev/null || echo "missing")
CONTAINER_STARTED=$(docker inspect --format='{{.State.StartedAt}}' xiaozhi-esp32-server-web 2>/dev/null || echo "")

if [ "$CONTAINER_STATUS" = "running" ] && [ -n "$CONTAINER_STARTED" ]; then
  STARTED_TS=$(date -d "$CONTAINER_STARTED" +%s 2>/dev/null || echo "0")
  UPTIME=$(( $(date +%s) - STARTED_TS ))
  if [ "$UPTIME" -gt 60 ]; then
    printf "  %-34sOK   uptime %ss\n" "Wait manager-api startup" "$UPTIME"
  else
    _wait_manager_api_startup 180 || exit 1
  fi
else
  _wait_manager_api_startup 180 || exit 1
fi

run_step "Sync manager-api secret" sync_manager_api_secret
run_step "Restart xiaozhi-server" restart_server_service
run_step "Wait xiaozhi-server startup" wait_server_running

FINAL_STATUS=$(docker inspect --format='{{.State.Status}}' xiaozhi-esp32-server-web 2>/dev/null || echo "missing")
if [ "$FINAL_STATUS" != "running" ]; then
  echo "ERROR: manager-api not running (status: $FINAL_STATUS)" >&2
  docker logs xiaozhi-esp32-server-web --tail 20 >&2
  exit 1
fi

SERVER_STATUS=$(docker inspect --format='{{.State.Status}}' xiaozhi-esp32-server 2>/dev/null || echo "missing")
if [ "$SERVER_STATUS" != "running" ]; then
  echo "WARNING: xiaozhi-server is not running yet (status: $SERVER_STATUS)." >&2
  echo "If this is the first install, configure manager-api.server.secret in $DATA_DIR/data/.config.yaml after creating the admin user, then restart with:" >&2
  echo "  docker compose -f $DATA_DIR/docker-compose.yml --env-file $DATA_DIR/.env up -d xiaozhi-esp32-server" >&2
  echo "--- xiaozhi-server last 20 log lines ---" >&2
  docker logs xiaozhi-esp32-server --tail 20 >&2 || true
fi

LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
echo ""
echo "=== Deploy complete ==="
echo "Version: $VERSION"
echo "Images: $(short_image_name "$(container_image xiaozhi-esp32-server)"), $(short_image_name "$(container_image xiaozhi-esp32-server-web)")"
echo "Runtime: $(short_image_name "$(container_image xiaozhi-esp32-server-db)"), $(short_image_name "$(container_image xiaozhi-esp32-server-redis)")"
echo "manager-web: http://$LOCAL_IP:8002"
echo "websocket:   ws://$LOCAL_IP:8000/xiaozhi/v1/"
