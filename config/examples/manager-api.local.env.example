# manager-api local environment example.
# Copy to an ignored private file, for example:
#   runtime/config/manager-api.local.env
#
# Do not commit API keys, database passwords, production addresses, or data/.config.yaml.

SERVER_PORT=8002
SERVER_SERVLET_CONTEXT_PATH=/xiaozhi
SPRING_PROFILES_ACTIVE=dev

# Local development database. Replace credentials only in the private copy.
SPRING_DATASOURCE_DRUID_URL=jdbc:mysql://127.0.0.1:3306/xiaozhi_esp32_server?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&nullCatalogMeansCurrent=true
SPRING_DATASOURCE_DRUID_USERNAME=xiaozhi_dev
SPRING_DATASOURCE_DRUID_PASSWORD=change_me_in_private_file

# Local development Redis.
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_DATABASE=0

# Required before saving encrypted agent-scoped integrations.
# Generate a private value with: openssl rand -base64 32
XIAOZHI_CREDENTIAL_ENCRYPTION_KEY=

# Runtime output roots for local runs.
XIAOZHI_RUNTIME_DIR=runtime
XIAOZHI_UPLOAD_DIR=runtime/uploads
XIAOZHI_TMP_DIR=runtime/tmp
XIAOZHI_LOG_DIR=runtime/logs
