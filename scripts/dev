#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_DIR="${DEV_LOG_DIR:-$ROOT_DIR/runtime/logs/dev}"
RUN_DIR="${DEV_RUN_DIR:-$ROOT_DIR/runtime/run}"
LOG_LINES="${DEV_LOG_LINES:-80}"

SERVICES=(api web server mobile)

usage() {
  cat <<'USAGE'
Usage:
  scripts/dev start [server|api|web|mobile|all]
  scripts/dev stop [server|api|web|mobile|all]
  scripts/dev status [server|api|web|mobile|all]
  scripts/dev logs [server|api|web|mobile|all] [-f|--follow]
  scripts/dev doctor
  scripts/dev help

Targets:
  server  main/xiaozhi-server, websocket 8000, HTTP/OTA 8003
  api     main/manager-api, HTTP 8002
  web     main/manager-web, HTTP 8001
  mobile  main/manager-mobile, H5 dev server 9000
  all     api, web, server, mobile

Environment:
  DEV_SKIP_INFRA=1    Do not try to start MySQL/Redis before api/all.
  DEV_API_MAVEN_RUN=1 Use mvn spring-boot:run for api instead of fast java start.
  DEV_API_FORCE_COMPILE=1 Compile manager-api before fast java start.
  XIAOZHI_SERVER_PYTHON=/path/to/python
                       Override the xiaozhi-server Python interpreter.
  XIAOZHI_LOG_LEVEL=DEBUG  Enable verbose manager-api application logs.
  DEV_LOG_LINES=120   Change lines shown by logs.
  DEV_LOG_DIR=...     Override runtime/logs/dev.
  DEV_RUN_DIR=...     Override runtime/run.
USAGE
}

log() {
  printf '[%s] %s\n' "$(date '+%F %T')" "$*"
}

warn() {
  printf '[%s] WARN: %s\n' "$(date '+%F %T')" "$*" >&2
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

conda_env_exists() {
  local env_name="$1"

  command_exists conda || return 1
  conda env list 2>/dev/null | awk '{print $1}' | grep -Fxq "$env_name"
}

require_command() {
  command_exists "$1" || die "Missing required command: $1"
}

ensure_runtime_dirs() {
  mkdir -p "$LOG_DIR" "$RUN_DIR"
}

service_name() {
  case "$1" in
    api) echo "manager-api" ;;
    web) echo "manager-web" ;;
    server) echo "xiaozhi-server" ;;
    mobile) echo "manager-mobile" ;;
    *) die "Unknown target: $1" ;;
  esac
}

service_workdir() {
  case "$1" in
    api) echo "$ROOT_DIR/main/manager-api" ;;
    web) echo "$ROOT_DIR/main/manager-web" ;;
    server) echo "$ROOT_DIR/main/xiaozhi-server" ;;
    mobile) echo "$ROOT_DIR/main/manager-mobile" ;;
    *) die "Unknown target: $1" ;;
  esac
}

service_ports() {
  case "$1" in
    api) echo "8002" ;;
    web) echo "8001" ;;
    server) echo "8000 8003" ;;
    mobile) echo "9000" ;;
    *) die "Unknown target: $1" ;;
  esac
}

pid_file_for_name() {
  echo "$RUN_DIR/$1.pid"
}

log_file_for_name() {
  echo "$LOG_DIR/$1.log"
}

read_pid_file() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  tr -d '[:space:]' <"$file" 2>/dev/null || return 1
}

pid_is_running() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" >/dev/null 2>&1
}

port_is_listening() {
  local port="$1"

  if command_exists ss; then
    ss -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]${port}$"
    return $?
  fi

  if command_exists lsof; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
    return $?
  fi

  if command_exists netstat; then
    netstat -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]${port}$"
    return $?
  fi

  return 1
}

port_detail() {
  local port="$1"

  if command_exists ss; then
    ss -ltnp 2>/dev/null | awk -v p=":$port" '$4 ~ p "$" {print; found=1; exit} END {exit found ? 0 : 1}'
    return $?
  fi

  if command_exists lsof; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | sed -n '2p'
    return $?
  fi

  return 1
}

expand_target() {
  local target="${1:-all}"
  case "$target" in
    all) printf '%s\n' "${SERVICES[@]}" ;;
    api|web|server|mobile) printf '%s\n' "$target" ;;
    *) die "Unknown target: $target" ;;
  esac
}

start_system_service() {
  local service="$1"
  local unit="$service.service"

  if command_exists systemctl && systemctl list-unit-files "$unit" >/dev/null 2>&1; then
    if [[ "$(id -u)" -eq 0 ]]; then
      systemctl start "$service" || warn "Failed to start $service with systemctl"
    elif command_exists sudo && sudo -n true >/dev/null 2>&1; then
      sudo systemctl start "$service" || warn "Failed to start $service with sudo systemctl"
    else
      warn "No non-interactive sudo available; skip starting $service"
    fi
    return
  fi

  if command_exists service; then
    if [[ "$(id -u)" -eq 0 ]]; then
      service "$service" start || warn "Failed to start $service with service"
    elif command_exists sudo && sudo -n true >/dev/null 2>&1; then
      sudo service "$service" start || warn "Failed to start $service with sudo service"
    else
      warn "No non-interactive sudo available; skip starting $service"
    fi
  fi
}

start_infra() {
  if [[ "${DEV_SKIP_INFRA:-0}" == "1" || "${DEV_SKIP_INFRA:-}" == "true" ]]; then
    log "Skipping MySQL/Redis startup because DEV_SKIP_INFRA is set"
    return
  fi

  log "Checking infrastructure services"
  start_system_service mysql
  start_system_service redis-server

  if port_is_listening 3306; then
    log "MySQL is listening on 3306"
  else
    warn "MySQL is not listening on 3306"
  fi

  if port_is_listening 6379; then
    log "Redis is listening on 6379"
  else
    warn "Redis is not listening on 6379"
  fi
}

ensure_npm_deps() {
  local dir="$1"
  require_command npm

  if [[ ! -d "$dir/node_modules" ]]; then
    log "Installing dependencies in $dir with npm install"
    (cd "$dir" && npm install)
  fi
}

ensure_pnpm_deps() {
  local dir="$1"
  require_command pnpm

  if [[ ! -d "$dir/node_modules" ]]; then
    log "Installing dependencies in $dir with pnpm install"
    (cd "$dir" && pnpm install)
  fi
}

start_process() {
  local name="$1"
  local port="$2"
  local workdir="$3"
  shift 3

  ensure_runtime_dirs

  [[ -d "$workdir" ]] || die "Missing workdir: $workdir"

  local pid_file
  local log_file
  pid_file="$(pid_file_for_name "$name")"
  log_file="$(log_file_for_name "$name")"

  if [[ -f "$pid_file" ]]; then
    local old_pid
    old_pid="$(read_pid_file "$pid_file" || true)"
    if [[ -n "$old_pid" ]] && pid_is_running "$old_pid"; then
      log "$name is already running with pid $old_pid"
      return
    fi
    warn "Removing stale pid file $pid_file"
    rm -f "$pid_file"
  fi

  if [[ -n "$port" ]] && port_is_listening "$port"; then
    warn "$name port $port is already listening; skip starting a duplicate"
    port_detail "$port" || true
    return
  fi

  log "Starting $name"
  (
    cd "$workdir"
    if command_exists setsid; then
      setsid "$@" >"$log_file" 2>&1 < /dev/null &
    else
      nohup "$@" >"$log_file" 2>&1 < /dev/null &
    fi
    printf '%s\n' "$!" >"$pid_file"
  )

  sleep 1

  local new_pid
  new_pid="$(read_pid_file "$pid_file" || true)"
  if [[ -n "$new_pid" ]] && pid_is_running "$new_pid"; then
    log "$name started, pid $new_pid, log $log_file"
  else
    warn "$name exited soon after startup; see $log_file"
    tail -n 40 "$log_file" 2>/dev/null || true
    return 1
  fi
}

start_api() {
  local dir
  dir="$(service_workdir api)"

  if [[ "${DEV_API_MAVEN_RUN:-0}" == "1" ]]; then
    require_command mvn
    start_process \
      "manager-api" \
      "8002" \
      "$dir" \
      mvn spring-boot:run -Dspring-boot.run.profiles=dev
    return
  fi

  require_command java
  require_command mvn

  if [[ "${DEV_API_FORCE_COMPILE:-0}" == "1" || ! -d "$dir/target/classes" ]]; then
    log "Compiling manager-api before fast start"
    (cd "$dir" && mvn -q -DskipTests compile)
  fi

  local classpath_file="$dir/target/classpath.dev"
  if [[ ! -s "$classpath_file" || "$dir/pom.xml" -nt "$classpath_file" ]]; then
    log "Refreshing manager-api dependency classpath"
    (
      cd "$dir"
      mvn -q -DincludeScope=runtime -Dmdep.outputFile=target/classpath.dev dependency:build-classpath
    )
  fi

  if [[ ! -s "$classpath_file" ]]; then
    warn "Fast api classpath is unavailable; falling back to mvn spring-boot:run"
    start_process \
      "manager-api" \
      "8002" \
      "$dir" \
      mvn spring-boot:run -Dspring-boot.run.profiles=dev
    return
  fi

  start_process \
    "manager-api" \
    "8002" \
    "$dir" \
    java -XX:TieredStopAtLevel=1 -cp "target/classes:$(cat "$classpath_file")" xiaozhi.AdminApplication --spring.profiles.active=dev
}

start_web() {
  local dir
  dir="$(service_workdir web)"
  ensure_npm_deps "$dir"
  start_process \
    "manager-web" \
    "8001" \
    "$dir" \
    npm run serve
}

start_server() {
  local dir
  dir="$(service_workdir server)"

  if [[ -n "${XIAOZHI_SERVER_PYTHON:-}" ]]; then
    [[ -x "$XIAOZHI_SERVER_PYTHON" ]] || die "XIAOZHI_SERVER_PYTHON is not executable: $XIAOZHI_SERVER_PYTHON"
    start_process "xiaozhi-server" "8000" "$dir" "$XIAOZHI_SERVER_PYTHON" app.py
    return
  fi

  local conda_env_python="$HOME/miniconda3/envs/xiaozhi-esp32-server/bin/python"
  if [[ -x "$conda_env_python" ]]; then
    start_process "xiaozhi-server" "8000" "$dir" "$conda_env_python" app.py
  elif conda_env_exists "xiaozhi-esp32-server"; then
    start_process "xiaozhi-server" "8000" "$dir" conda run -n xiaozhi-esp32-server python app.py
  else
    die "Missing Conda env 'xiaozhi-esp32-server'. Refusing to start xiaozhi-server with system Python. See docs/development/local-dev-workflow.md."
  fi
}

start_mobile() {
  local dir
  dir="$(service_workdir mobile)"
  ensure_pnpm_deps "$dir"
  start_process \
    "manager-mobile" \
    "9000" \
    "$dir" \
    pnpm dev:h5
}

start_target() {
  local target="${1:-all}"

  log "Project root: $ROOT_DIR"
  if [[ "$target" == "api" || "$target" == "all" ]]; then
    start_infra
  fi

  local service
  while IFS= read -r service; do
    case "$service" in
      api) start_api ;;
      web) start_web ;;
      server) start_server ;;
      mobile) start_mobile ;;
    esac
  done < <(expand_target "$target")

  log "Startup commands submitted"
  log "manager-web:    http://127.0.0.1:8001"
  log "manager-api:    http://127.0.0.1:8002/xiaozhi/doc.html"
  log "xiaozhi-server: ws://127.0.0.1:8000/xiaozhi/v1/"
  log "xiaozhi OTA:    http://127.0.0.1:8003/xiaozhi/ota/"
  log "manager-mobile: http://127.0.0.1:9000"
}

stop_process() {
  local name="$1"
  local pid_file
  pid_file="$(pid_file_for_name "$name")"

  if [[ ! -f "$pid_file" ]]; then
    log "$name is not managed by scripts/dev"
    return
  fi

  local pid
  pid="$(read_pid_file "$pid_file" || true)"
  if [[ -z "$pid" ]] || ! pid_is_running "$pid"; then
    warn "$name pid file is stale; removing $pid_file"
    rm -f "$pid_file"
    return
  fi

  log "Stopping $name pid $pid"
  kill -- "-$pid" >/dev/null 2>&1 || kill "$pid" >/dev/null 2>&1 || true

  local waited=0
  while pid_is_running "$pid" && [[ "$waited" -lt 20 ]]; do
    sleep 0.5
    waited=$((waited + 1))
  done

  if pid_is_running "$pid"; then
    warn "$name did not exit; sending SIGKILL"
    kill -KILL -- "-$pid" >/dev/null 2>&1 || kill -KILL "$pid" >/dev/null 2>&1 || true
  fi

  rm -f "$pid_file"
  log "$name stopped"
}

stop_target() {
  local target="${1:-all}"
  local targets=()
  local service

  while IFS= read -r service; do
    targets+=("$service")
  done < <(expand_target "$target")

  local idx
  for ((idx=${#targets[@]}-1; idx>=0; idx--)); do
    stop_process "$(service_name "${targets[$idx]}")"
  done
}

status_service() {
  local target="$1"
  local name
  local pid_file
  local pid=""
  local state="stopped"
  name="$(service_name "$target")"
  pid_file="$(pid_file_for_name "$name")"

  if [[ -f "$pid_file" ]]; then
    pid="$(read_pid_file "$pid_file" || true)"
    if [[ -n "$pid" ]] && pid_is_running "$pid"; then
      state="running pid=$pid"
    else
      state="stale pid_file=$pid_file"
    fi
  fi

  printf '%-8s %-16s %-28s' "$target" "$name" "$state"

  local port
  for port in $(service_ports "$target"); do
    if port_is_listening "$port"; then
      printf ' port:%s=listening' "$port"
    else
      printf ' port:%s=closed' "$port"
    fi
  done

  printf '\n'
}

status_target() {
  local target="${1:-all}"
  printf 'Runtime logs: %s\n' "$LOG_DIR"
  printf 'Runtime pids: %s\n' "$RUN_DIR"

  local service
  while IFS= read -r service; do
    status_service "$service"
  done < <(expand_target "$target")
}

collect_log_files_for_service() {
  local target="$1"
  local name
  name="$(service_name "$target")"

  local candidates=(
    "$LOG_DIR/$name.log"
  )

  local file
  for file in "${candidates[@]}"; do
    [[ -f "$file" ]] && printf '%s\n' "$file"
  done
}

logs_target() {
  local target="${1:-all}"
  local follow="${2:-false}"
  local files=()
  local service
  local file

  while IFS= read -r service; do
    while IFS= read -r file; do
      files+=("$file")
    done < <(collect_log_files_for_service "$service")
  done < <(expand_target "$target")

  if [[ "${#files[@]}" -eq 0 ]]; then
    warn "No log files found for target: $target"
    return 1
  fi

  if [[ "$follow" == "true" ]]; then
    tail -n "$LOG_LINES" -F "${files[@]}"
    return
  fi

  for file in "${files[@]}"; do
    printf '\n==> %s <==\n' "$file"
    tail -n "$LOG_LINES" "$file" || true
  done
}

DOCTOR_FAILS=0

doctor_ok() {
  printf '[OK]   %s\n' "$*"
}

doctor_warn() {
  printf '[WARN] %s\n' "$*"
}

doctor_fail() {
  printf '[FAIL] %s\n' "$*"
  DOCTOR_FAILS=$((DOCTOR_FAILS + 1))
}

doctor_command() {
  local command_name="$1"
  local description="$2"

  if command_exists "$command_name"; then
    doctor_ok "$description: $(command -v "$command_name")"
  else
    doctor_fail "$description: missing command '$command_name'"
  fi
}

doctor_optional_command() {
  local command_name="$1"
  local description="$2"

  if command_exists "$command_name"; then
    doctor_ok "$description: $(command -v "$command_name")"
  else
    doctor_warn "$description: missing command '$command_name'"
  fi
}

doctor_dir() {
  local dir="$1"
  local description="$2"

  if [[ -d "$dir" ]]; then
    doctor_ok "$description: $dir"
  else
    doctor_fail "$description missing: $dir"
  fi
}

doctor_file() {
  local file="$1"
  local description="$2"
  local required="${3:-required}"

  if [[ -f "$file" ]]; then
    doctor_ok "$description: $file"
  elif [[ "$required" == "required" ]]; then
    doctor_fail "$description missing: $file"
  else
    doctor_warn "$description missing: $file"
  fi
}

doctor_port() {
  local port="$1"
  local description="$2"
  local expected="${3:-service}"

  if port_is_listening "$port"; then
    if [[ "$expected" == "infra" ]]; then
      doctor_ok "$description port $port is listening"
    else
      doctor_warn "$description port $port is already listening; check status before starting a duplicate"
    fi
    port_detail "$port" || true
  else
    if [[ "$expected" == "infra" ]]; then
      doctor_warn "$description port $port is not listening"
    else
      doctor_ok "$description port $port is free"
    fi
  fi
}

doctor_python() {
  if [[ -n "${XIAOZHI_SERVER_PYTHON:-}" ]]; then
    if [[ -x "$XIAOZHI_SERVER_PYTHON" ]]; then
      doctor_ok "Python env for xiaozhi-server from XIAOZHI_SERVER_PYTHON: $XIAOZHI_SERVER_PYTHON"
    else
      doctor_fail "XIAOZHI_SERVER_PYTHON is not executable: $XIAOZHI_SERVER_PYTHON"
    fi
    return
  fi

  local conda_env_python="$HOME/miniconda3/envs/xiaozhi-esp32-server/bin/python"
  if [[ -x "$conda_env_python" ]]; then
    doctor_ok "Python env for xiaozhi-server: $conda_env_python"
  elif conda_env_exists "xiaozhi-esp32-server"; then
    doctor_ok "Conda env for xiaozhi-server is available: xiaozhi-esp32-server"
  elif command_exists conda; then
    doctor_fail "Conda is available, but env 'xiaozhi-esp32-server' is missing"
  else
    doctor_fail "Conda env 'xiaozhi-esp32-server' is missing; system Python is not accepted for xiaozhi-server"
  fi
}

doctor() {
  printf 'Project root: %s\n' "$ROOT_DIR"
  printf 'Runtime logs: %s\n' "$LOG_DIR"
  printf 'Runtime pids: %s\n\n' "$RUN_DIR"

  printf 'Commands\n'
  doctor_command bash "Bash"
  doctor_command java "JDK for manager-api"
  doctor_command mvn "Maven for manager-api"
  doctor_command node "Node.js for frontends"
  doctor_command npm "npm for manager-web"
  doctor_command pnpm "pnpm for manager-mobile"
  doctor_python
  doctor_optional_command mysql "MySQL client"
  doctor_optional_command redis-cli "Redis client"
  doctor_optional_command ffmpeg "FFmpeg for audio processing"
  if command_exists ss || command_exists lsof || command_exists netstat; then
    doctor_ok "Port inspection command is available"
  else
    doctor_warn "No ss/lsof/netstat found; port checks will be limited"
  fi

  printf '\nDirectories\n'
  doctor_dir "$ROOT_DIR/main/xiaozhi-server" "xiaozhi-server directory"
  doctor_dir "$ROOT_DIR/main/manager-api" "manager-api directory"
  doctor_dir "$ROOT_DIR/main/manager-web" "manager-web directory"
  doctor_dir "$ROOT_DIR/main/manager-mobile" "manager-mobile directory"
  if [[ -d "$ROOT_DIR/runtime" ]]; then
    doctor_ok "runtime directory exists: $ROOT_DIR/runtime"
  elif [[ -w "$ROOT_DIR" ]]; then
    doctor_ok "runtime directory can be created under project root"
  else
    doctor_fail "project root is not writable for runtime directory"
  fi

  printf '\nConfiguration\n'
  doctor_file "$ROOT_DIR/main/manager-api/src/main/resources/application-dev.yml" "manager-api dev config"
  doctor_file "$ROOT_DIR/main/xiaozhi-server/data/.config.yaml" "xiaozhi-server private config" optional
  doctor_file "$ROOT_DIR/main/xiaozhi-server/config_from_api.yaml" "xiaozhi-server API config template" optional
  doctor_file "$ROOT_DIR/main/manager-mobile/env/.env.development" "manager-mobile dev env" optional

  printf '\nPorts\n'
  doctor_port 3306 "MySQL" infra
  doctor_port 6379 "Redis" infra
  doctor_port 8002 "manager-api"
  doctor_port 8001 "manager-web"
  doctor_port 8000 "xiaozhi-server websocket"
  doctor_port 8003 "xiaozhi-server HTTP/OTA"
  doctor_port 9000 "manager-mobile H5"

  if [[ "$DOCTOR_FAILS" -gt 0 ]]; then
    printf '\nDoctor found %s failure(s).\n' "$DOCTOR_FAILS"
    return 1
  fi

  printf '\nDoctor finished without failures.\n'
}

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    start)
      start_target "${1:-all}"
      ;;
    stop)
      stop_target "${1:-all}"
      ;;
    status)
      status_target "${1:-all}"
      ;;
    logs)
      local target="${1:-all}"
      local follow="false"
      if [[ "$target" == "-f" || "$target" == "--follow" ]]; then
        target="${2:-all}"
        follow="true"
      elif [[ "${2:-}" == "-f" || "${2:-}" == "--follow" ]]; then
        follow="true"
      fi
      logs_target "$target" "$follow"
      ;;
    doctor)
      doctor
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage >&2
      die "Unknown command: $command"
      ;;
  esac
}

main "$@"
