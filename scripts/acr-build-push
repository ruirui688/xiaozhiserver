#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

ACR_REGISTRY="${ACR_REGISTRY:-crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com}"
ACR_NAMESPACE="${ACR_NAMESPACE:-yihuixiaozhi}"
SERVER_IMAGE_REPOSITORY="${SERVER_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/xiaozhi-server}"
WEB_IMAGE_REPOSITORY="${WEB_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/xiaozhi-web}"
SERVER_BASE_IMAGE_REPOSITORY="${SERVER_BASE_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/xiaozhi-server-base}"
MYSQL_IMAGE_REPOSITORY="${MYSQL_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/mysql}"
REDIS_IMAGE_REPOSITORY="${REDIS_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/redis}"
PLATFORMS="${PLATFORMS:-linux/amd64}"
PUSH="${PUSH:-true}"
BUILD_BASE="${BUILD_BASE:-auto}"
BUILD_ENGINE="${BUILD_ENGINE:-docker}"
PYTHON_BASE_IMAGE="${PYTHON_BASE_IMAGE:-python:3.10-slim-bookworm}"
SERVER_BASE_IMAGE="${SERVER_BASE_IMAGE:-}"
MIRROR_RUNTIME_IMAGES="${MIRROR_RUNTIME_IMAGES:-auto}"
MYSQL_SOURCE_IMAGE="${MYSQL_SOURCE_IMAGE:-mysql:8.4}"
REDIS_SOURCE_IMAGE="${REDIS_SOURCE_IMAGE:-redis:8.0}"
VERBOSE="${VERBOSE:-false}"
INSTALL_FUNASR_MODEL="${INSTALL_FUNASR_MODEL:-true}"
FUNASR_MODEL_URL="${FUNASR_MODEL_URL:-https://modelscope.cn/models/iic/SenseVoiceSmall/resolve/master/model.pt}"
FUNASR_MODEL_LOCAL_PATH="${FUNASR_MODEL_LOCAL_PATH:-}"
FUNASR_MODEL_CONTEXT="${FUNASR_MODEL_CONTEXT:-}"
XIAOZHI_DOCKER_QUIET="${XIAOZHI_DOCKER_QUIET:-true}"
XIAOZHI_PROGRESS="${XIAOZHI_PROGRESS:-true}"
XIAOZHI_PROGRESS_INTERVAL="${XIAOZHI_PROGRESS_INTERVAL:-5}"
PARALLEL_RELEASE_STEPS_CONFIGURED="${PARALLEL_RELEASE_STEPS+x}"
PARALLEL_IMAGE_BUILDS_CONFIGURED="${PARALLEL_IMAGE_BUILDS+x}"
PARALLEL_RELEASE_STEPS="${PARALLEL_RELEASE_STEPS:-true}"
PARALLEL_IMAGE_BUILDS="${PARALLEL_IMAGE_BUILDS:-true}"

is_quiet() {
  [[ "$VERBOSE" != "true" && "$XIAOZHI_DOCKER_QUIET" == "true" ]]
}

short_image_name() {
  local image="$1"
  printf '%s' "${image##*/}"
}

if [[ -z "${VERSION:-}" ]]; then
  if VERSION_TAG="$(git -C "$ROOT_DIR" describe --tags --exact-match 2>/dev/null)"; then
    VERSION="${VERSION_TAG#v}"
  elif VERSION_SHA="$(git -C "$ROOT_DIR" rev-parse --short=8 HEAD 2>/dev/null)"; then
    VERSION="$VERSION_SHA"
  else
    VERSION="local"
  fi
fi

image_tag() {
  local image="$1"
  local tail="${image##*/}"
  if [[ "$tail" != *:* ]]; then
    echo "Source image must include an explicit tag: $image" >&2
    exit 1
  fi
  echo "${tail##*:}"
}

MYSQL_TARGET_TAG="$(image_tag "$MYSQL_SOURCE_IMAGE")"
REDIS_TARGET_TAG="$(image_tag "$REDIS_SOURCE_IMAGE")"

if [[ "$PARALLEL_RELEASE_STEPS" != "true" && "$PARALLEL_RELEASE_STEPS" != "false" ]]; then
  echo "PARALLEL_RELEASE_STEPS must be true or false" >&2
  exit 1
fi

if [[ "$PARALLEL_IMAGE_BUILDS" != "true" && "$PARALLEL_IMAGE_BUILDS" != "false" ]]; then
  echo "PARALLEL_IMAGE_BUILDS must be true or false" >&2
  exit 1
fi

if [[ "$BUILD_BASE" != "true" && "$BUILD_BASE" != "false" && "$BUILD_BASE" != "auto" ]]; then
  echo "BUILD_BASE must be true, false, or auto" >&2
  exit 1
fi

if [[ "$MIRROR_RUNTIME_IMAGES" != "true" && "$MIRROR_RUNTIME_IMAGES" != "false" && "$MIRROR_RUNTIME_IMAGES" != "auto" ]]; then
  echo "MIRROR_RUNTIME_IMAGES must be true, false, or auto" >&2
  exit 1
fi

if [[ "$INSTALL_FUNASR_MODEL" != "true" && "$INSTALL_FUNASR_MODEL" != "false" ]]; then
  echo "INSTALL_FUNASR_MODEL must be true or false" >&2
  exit 1
fi

if [[ "$XIAOZHI_PROGRESS" != "true" && "$XIAOZHI_PROGRESS" != "false" ]]; then
  echo "XIAOZHI_PROGRESS must be true or false" >&2
  exit 1
fi

if [[ ! "$XIAOZHI_PROGRESS_INTERVAL" =~ ^[0-9]+$ || "$XIAOZHI_PROGRESS_INTERVAL" -le 0 ]]; then
  echo "XIAOZHI_PROGRESS_INTERVAL must be a positive integer" >&2
  exit 1
fi

if [[ "$VERBOSE" != "true" && "$XIAOZHI_DOCKER_QUIET" == "true" && "$XIAOZHI_PROGRESS" == "true" && -t 1 ]]; then
  if [[ -z "$PARALLEL_RELEASE_STEPS_CONFIGURED" ]]; then
    PARALLEL_RELEASE_STEPS=false
  fi
  if [[ -z "$PARALLEL_IMAGE_BUILDS_CONFIGURED" ]]; then
    PARALLEL_IMAGE_BUILDS=false
  fi
fi

print_release_summary() {
  if is_quiet; then
    cat <<EOF
ACR release
  version:   $VERSION
  images:    $(short_image_name "$SERVER_IMAGE_REPOSITORY:$VERSION"), $(short_image_name "$WEB_IMAGE_REPOSITORY:$VERSION")
  runtime:   mysql:$MYSQL_TARGET_TAG, redis:$REDIS_TARGET_TAG
  options:   engine=$BUILD_ENGINE base=$BUILD_BASE runtime=$MIRROR_RUNTIME_IMAGES parallel=$PARALLEL_RELEASE_STEPS/$PARALLEL_IMAGE_BUILDS
  funasr:    cpu=true model=$INSTALL_FUNASR_MODEL
  output:    quiet progress=$XIAOZHI_PROGRESS interval=${XIAOZHI_PROGRESS_INTERVAL}s

EOF
    return
  fi

  cat <<EOF
Building and pushing xiaozhi images to Aliyun ACR.

Version:
  $VERSION

Image repositories:
  server:      $SERVER_IMAGE_REPOSITORY
  web:         $WEB_IMAGE_REPOSITORY
  server-base: $SERVER_BASE_IMAGE_REPOSITORY
  mysql:       $MYSQL_IMAGE_REPOSITORY:$MYSQL_TARGET_TAG
  redis:       $REDIS_IMAGE_REPOSITORY:$REDIS_TARGET_TAG

Runtime image sources:
  mysql:       $MYSQL_SOURCE_IMAGE
  redis:       $REDIS_SOURCE_IMAGE

Default build engine:
  $BUILD_ENGINE

Build options:
  build_base=$BUILD_BASE server_base_image=${SERVER_BASE_IMAGE:-auto}
  mirror_runtime_images=$MIRROR_RUNTIME_IMAGES
  install_funasr_model=$INSTALL_FUNASR_MODEL
  funasr_model_local_path=${FUNASR_MODEL_LOCAL_PATH:-auto}
  funasr_model_context=${FUNASR_MODEL_CONTEXT:-auto}
  funasr_model_url=$FUNASR_MODEL_URL

Docker output:
  quiet=$XIAOZHI_DOCKER_QUIET verbose=$VERBOSE
  progress=$XIAOZHI_PROGRESS bar_interval=${XIAOZHI_PROGRESS_INTERVAL}s

Parallelism:
  release_steps=$PARALLEL_RELEASE_STEPS image_builds=$PARALLEL_IMAGE_BUILDS

This command still needs access to Docker build base images unless you override
PYTHON_BASE_IMAGE, NODE_BASE_IMAGE, MAVEN_BASE_IMAGE, and WEB_RUNTIME_BASE_IMAGE.
EOF
}

print_release_summary

mirror_runtime_images() {
  ACR_REGISTRY="$ACR_REGISTRY" \
    ACR_NAMESPACE="$ACR_NAMESPACE" \
    MYSQL_SOURCE_IMAGE="$MYSQL_SOURCE_IMAGE" \
    REDIS_SOURCE_IMAGE="$REDIS_SOURCE_IMAGE" \
    MYSQL_IMAGE_REPOSITORY="$MYSQL_IMAGE_REPOSITORY" \
    REDIS_IMAGE_REPOSITORY="$REDIS_IMAGE_REPOSITORY" \
    VERBOSE="$VERBOSE" \
    XIAOZHI_DOCKER_QUIET="$XIAOZHI_DOCKER_QUIET" \
    XIAOZHI_PROGRESS="$XIAOZHI_PROGRESS" \
    XIAOZHI_PROGRESS_INTERVAL="$XIAOZHI_PROGRESS_INTERVAL" \
    "$ROOT_DIR/scripts/acr-mirror-runtime-images"
}

should_mirror_runtime_images() {
  [[ "$PUSH" == "true" ]] || return 1

  if [[ "$MIRROR_RUNTIME_IMAGES" == "false" ]]; then
    return 1
  fi

  if [[ "$MIRROR_RUNTIME_IMAGES" == "true" ]]; then
    return 0
  fi

  local missing=false
  for image in "$MYSQL_IMAGE_REPOSITORY:$MYSQL_TARGET_TAG" "$REDIS_IMAGE_REPOSITORY:$REDIS_TARGET_TAG"; do
    if docker manifest inspect "$image" >/dev/null 2>&1; then
      if is_quiet; then
        echo "Runtime OK: $(short_image_name "$image")"
      else
        echo "Runtime image already exists in ACR: $image"
      fi
    else
      if is_quiet; then
        echo "Runtime mirror needed: $(short_image_name "$image")"
      else
        echo "Runtime image missing in ACR, will mirror: $image"
      fi
      missing=true
    fi
  done

  [[ "$missing" == "true" ]]
}

build_business_images() {
  SERVER_IMAGE_REPOSITORY="$SERVER_IMAGE_REPOSITORY" \
  WEB_IMAGE_REPOSITORY="$WEB_IMAGE_REPOSITORY" \
  SERVER_BASE_IMAGE_REPOSITORY="$SERVER_BASE_IMAGE_REPOSITORY" \
  BUILD_BASE="$BUILD_BASE" \
  SERVER_BASE_IMAGE="$SERVER_BASE_IMAGE" \
  BUILD_ENGINE="$BUILD_ENGINE" \
  PYTHON_BASE_IMAGE="$PYTHON_BASE_IMAGE" \
  PUSH="$PUSH" \
  PLATFORMS="$PLATFORMS" \
  VERSION="$VERSION" \
  VERBOSE="$VERBOSE" \
  XIAOZHI_DOCKER_QUIET="$XIAOZHI_DOCKER_QUIET" \
  XIAOZHI_PROGRESS="$XIAOZHI_PROGRESS" \
  XIAOZHI_PROGRESS_INTERVAL="$XIAOZHI_PROGRESS_INTERVAL" \
  INSTALL_FUNASR_MODEL="$INSTALL_FUNASR_MODEL" \
  FUNASR_MODEL_URL="$FUNASR_MODEL_URL" \
  FUNASR_MODEL_LOCAL_PATH="$FUNASR_MODEL_LOCAL_PATH" \
  FUNASR_MODEL_CONTEXT="$FUNASR_MODEL_CONTEXT" \
  PARALLEL_IMAGE_BUILDS="$PARALLEL_IMAGE_BUILDS" \
  PRINT_BUILD_CONFIG=false \
  "$ROOT_DIR/scripts/docker-build-private.sh"
}

wait_for_release_step() {
  local label="$1"
  local pid="$2"

  if wait "$pid"; then
    echo "$label step OK"
    return 0
  fi
  echo "$label step FAILED" >&2
  return 1
}

RUNTIME_MIRROR_NEEDED=false
if should_mirror_runtime_images; then
  RUNTIME_MIRROR_NEEDED=true
fi

if [[ "$RUNTIME_MIRROR_NEEDED" == "true" && "$PARALLEL_RELEASE_STEPS" == "true" ]]; then
  mirror_runtime_images &
  MIRROR_PID=$!
  build_business_images &
  BUILD_PID=$!

  RELEASE_STATUS=0
  wait_for_release_step "Runtime image mirror" "$MIRROR_PID" || RELEASE_STATUS=1
  wait_for_release_step "Business image build" "$BUILD_PID" || RELEASE_STATUS=1
  exit "$RELEASE_STATUS"
fi

if [[ "$RUNTIME_MIRROR_NEEDED" == "true" ]]; then
  mirror_runtime_images
fi

build_business_images

echo ""
echo "=== Build complete ==="
echo "Version: $VERSION"
echo "Deploy: VERSION=$VERSION ./deploy/production/upgrade"
echo ""
