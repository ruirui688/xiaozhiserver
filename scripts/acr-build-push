#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

ACR_REGISTRY="${ACR_REGISTRY:-crpi-jxcli7cptlgilqfx.cn-hangzhou.personal.cr.aliyuncs.com}"
ACR_NAMESPACE="${ACR_NAMESPACE:-yihuixiaozhi}"
SERVER_IMAGE_REPOSITORY="${SERVER_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/xiaozhi-server}"
MANAGER_API_IMAGE_REPOSITORY="${MANAGER_API_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/xiaozhi-manager-api}"
MANAGER_WEB_IMAGE_REPOSITORY="${MANAGER_WEB_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/xiaozhi-manager-web}"
DEPLOY_ASSETS_IMAGE_REPOSITORY="${DEPLOY_ASSETS_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/xiaozhi-deploy-assets}"
SERVER_COMMON_BASE_IMAGE_REPOSITORY="${SERVER_COMMON_BASE_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/xiaozhi-server-base-common}"
SERVER_LITE_BASE_IMAGE_REPOSITORY="${SERVER_LITE_BASE_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/xiaozhi-server-base-lite}"
SERVER_FUNASR_BASE_IMAGE_REPOSITORY="${SERVER_FUNASR_BASE_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/xiaozhi-server-base-funasr}"
MYSQL_IMAGE_REPOSITORY="${MYSQL_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/mysql}"
REDIS_IMAGE_REPOSITORY="${REDIS_IMAGE_REPOSITORY:-$ACR_REGISTRY/$ACR_NAMESPACE/redis}"
PLATFORMS="${PLATFORMS:-linux/amd64}"
PUSH="${PUSH:-true}"
BUILD_BASE="${BUILD_BASE:-auto}"
BUILD_ENGINE="${BUILD_ENGINE:-docker}"
IMAGE_TAG_SUFFIX="${IMAGE_TAG_SUFFIX:-}"
CHANNEL_TAG="${CHANNEL_TAG:-latest}"
PYTHON_BASE_IMAGE="${PYTHON_BASE_IMAGE:-docker.m.daocloud.io/library/python:3.10-slim-bookworm}"
NODE_BASE_IMAGE="${NODE_BASE_IMAGE:-docker.m.daocloud.io/library/node:20}"
MAVEN_BASE_IMAGE="${MAVEN_BASE_IMAGE:-docker.m.daocloud.io/library/maven:3.9.4-eclipse-temurin-21}"
WEB_RUNTIME_BASE_IMAGE="${WEB_RUNTIME_BASE_IMAGE:-docker.m.daocloud.io/bellsoft/liberica-runtime-container:jre-21-glibc}"
API_RUNTIME_BASE_IMAGE="${API_RUNTIME_BASE_IMAGE:-$WEB_RUNTIME_BASE_IMAGE}"
MANAGER_WEB_RUNTIME_BASE_IMAGE="${MANAGER_WEB_RUNTIME_BASE_IMAGE:-docker.m.daocloud.io/library/alpine:3.20}"
RELEASE_ASSETS_BASE_IMAGE="${RELEASE_ASSETS_BASE_IMAGE:-docker.m.daocloud.io/library/alpine:3.20}"
SERVER_INSTALL_PROFILE="${SERVER_INSTALL_PROFILE:-lite}"
case "$SERVER_INSTALL_PROFILE" in
  standard | lite)
    SERVER_INSTALL_PROFILE="lite"
    SERVER_REQUIREMENTS="${SERVER_REQUIREMENTS:-main/xiaozhi-server/requirements-docker.txt}"
    INSTALL_FUNASR_MODEL="${INSTALL_FUNASR_MODEL:-false}"
    ;;
  funasr)
    SERVER_REQUIREMENTS="${SERVER_REQUIREMENTS:-main/xiaozhi-server/requirements-docker.txt}"
    SERVER_REQUIREMENTS_FUNASR="${SERVER_REQUIREMENTS_FUNASR:-main/xiaozhi-server/requirements-docker-funasr-extra.txt}"
    INSTALL_FUNASR_MODEL="${INSTALL_FUNASR_MODEL:-true}"
    ;;
  *)
    echo "SERVER_INSTALL_PROFILE must be lite, standard, or funasr" >&2
    exit 1
    ;;
esac
if [[ -z "${SERVER_BASE_IMAGE_REPOSITORY:-}" ]]; then
  if [[ "$SERVER_INSTALL_PROFILE" == "funasr" ]]; then
    SERVER_BASE_IMAGE_REPOSITORY="$SERVER_FUNASR_BASE_IMAGE_REPOSITORY"
  else
    SERVER_BASE_IMAGE_REPOSITORY="$SERVER_LITE_BASE_IMAGE_REPOSITORY"
  fi
fi
SERVER_BASE_IMAGE="${SERVER_BASE_IMAGE:-}"
MIRROR_RUNTIME_IMAGES="${MIRROR_RUNTIME_IMAGES:-auto}"
MYSQL_SOURCE_IMAGE="${MYSQL_SOURCE_IMAGE:-mysql:8.4}"
REDIS_SOURCE_IMAGE="${REDIS_SOURCE_IMAGE:-redis:8.0}"
VERBOSE="${VERBOSE:-false}"
FUNASR_MODEL_URL="${FUNASR_MODEL_URL:-https://modelscope.cn/models/iic/SenseVoiceSmall/resolve/master/model.pt}"
FUNASR_MODEL_LOCAL_PATH="${FUNASR_MODEL_LOCAL_PATH:-}"
FUNASR_MODEL_CONTEXT="${FUNASR_MODEL_CONTEXT:-}"
XIAOZHI_DOCKER_QUIET="${XIAOZHI_DOCKER_QUIET:-true}"
XIAOZHI_PROGRESS="${XIAOZHI_PROGRESS:-true}"
XIAOZHI_PROGRESS_INTERVAL="${XIAOZHI_PROGRESS_INTERVAL:-5}"
SERVER_BASE_CACHE_VERSION="${SERVER_BASE_CACHE_VERSION:-v2}"
SERVER_BASE_SEED_LATEST="${SERVER_BASE_SEED_LATEST:-false}"
PRINT_BUILD_CONFIG_ONLY="${PRINT_BUILD_CONFIG_ONLY:-false}"
MANAGER_API_CACHE_VERSION="${MANAGER_API_CACHE_VERSION:-v1}"
MANAGER_WEB_CACHE_VERSION="${MANAGER_WEB_CACHE_VERSION:-v1}"
PARALLEL_RELEASE_STEPS_CONFIGURED="${PARALLEL_RELEASE_STEPS+x}"
PARALLEL_IMAGE_BUILDS_CONFIGURED="${PARALLEL_IMAGE_BUILDS+x}"
PARALLEL_RELEASE_STEPS="${PARALLEL_RELEASE_STEPS:-true}"
PARALLEL_IMAGE_BUILDS="${PARALLEL_IMAGE_BUILDS:-true}"
RELEASE_CONTRACT_VERSION="${RELEASE_CONTRACT_VERSION:-1}"

is_quiet() {
  [[ "$VERBOSE" != "true" && "$XIAOZHI_DOCKER_QUIET" == "true" ]]
}

short_image_name() {
  local image="$1"
  printf '%s' "${image##*/}"
}

if [[ -z "${VERSION:-}" ]]; then
  if VERSION_TAG="$(git -C "$ROOT_DIR" describe --tags --exact-match 2>/dev/null)"; then
    VERSION="${VERSION_TAG#v}"
  elif VERSION_SHA="$(git -C "$ROOT_DIR" rev-parse --short=8 HEAD 2>/dev/null)"; then
    VERSION="$VERSION_SHA"
  else
    VERSION="local"
  fi
fi
IMAGE_VERSION_TAG="${VERSION}${IMAGE_TAG_SUFFIX}"
SOURCE_COMMIT="$(git -C "$ROOT_DIR" rev-parse HEAD 2>/dev/null || printf unknown)"

if [[ "$PUSH" == "true" && "$PRINT_BUILD_CONFIG_ONLY" != "true" && ! "$SOURCE_COMMIT" =~ ^[0-9a-fA-F]{40}$ ]]; then
  echo "A versioned release must be built from a Git commit." >&2
  exit 1
fi

if [[ "$PUSH" == "true" && "$PRINT_BUILD_CONFIG_ONLY" != "true" ]] \
  && [[ -n "$(git -C "$ROOT_DIR" status --short 2>/dev/null)" ]]; then
  echo "Refusing to publish a versioned release from a dirty worktree." >&2
  echo "Commit the release inputs first; use PUSH=false for local validation builds." >&2
  exit 1
fi

image_tag() {
  local image="$1"
  local tail="${image##*/}"
  if [[ "$tail" != *:* ]]; then
    echo "Source image must include an explicit tag: $image" >&2
    exit 1
  fi
  echo "${tail##*:}"
}

MYSQL_TARGET_TAG="$(image_tag "$MYSQL_SOURCE_IMAGE")"
REDIS_TARGET_TAG="$(image_tag "$REDIS_SOURCE_IMAGE")"

if [[ "$PARALLEL_RELEASE_STEPS" != "true" && "$PARALLEL_RELEASE_STEPS" != "false" ]]; then
  echo "PARALLEL_RELEASE_STEPS must be true or false" >&2
  exit 1
fi

if [[ "$PARALLEL_IMAGE_BUILDS" != "true" && "$PARALLEL_IMAGE_BUILDS" != "false" ]]; then
  echo "PARALLEL_IMAGE_BUILDS must be true or false" >&2
  exit 1
fi

if [[ "$BUILD_BASE" != "true" && "$BUILD_BASE" != "false" && "$BUILD_BASE" != "auto" ]]; then
  echo "BUILD_BASE must be true, false, or auto" >&2
  exit 1
fi

if [[ "$MIRROR_RUNTIME_IMAGES" != "true" && "$MIRROR_RUNTIME_IMAGES" != "false" && "$MIRROR_RUNTIME_IMAGES" != "auto" ]]; then
  echo "MIRROR_RUNTIME_IMAGES must be true, false, or auto" >&2
  exit 1
fi

if [[ "$SERVER_BASE_SEED_LATEST" != "true" && "$SERVER_BASE_SEED_LATEST" != "false" ]]; then
  echo "SERVER_BASE_SEED_LATEST must be true or false" >&2
  exit 1
fi

if [[ "$PRINT_BUILD_CONFIG_ONLY" != "true" && "$PRINT_BUILD_CONFIG_ONLY" != "false" ]]; then
  echo "PRINT_BUILD_CONFIG_ONLY must be true or false" >&2
  exit 1
fi

if [[ "$INSTALL_FUNASR_MODEL" != "true" && "$INSTALL_FUNASR_MODEL" != "false" ]]; then
  echo "INSTALL_FUNASR_MODEL must be true or false" >&2
  exit 1
fi

if [[ "$SERVER_INSTALL_PROFILE" == "lite" && "$INSTALL_FUNASR_MODEL" == "true" ]]; then
  echo "SERVER_INSTALL_PROFILE=lite does not include local FunASR; use scripts/acr-build-push-funasr or SERVER_INSTALL_PROFILE=funasr." >&2
  exit 1
fi

if [[ "$XIAOZHI_PROGRESS" != "true" && "$XIAOZHI_PROGRESS" != "false" ]]; then
  echo "XIAOZHI_PROGRESS must be true or false" >&2
  exit 1
fi

if [[ ! "$XIAOZHI_PROGRESS_INTERVAL" =~ ^[0-9]+$ || "$XIAOZHI_PROGRESS_INTERVAL" -le 0 ]]; then
  echo "XIAOZHI_PROGRESS_INTERVAL must be a positive integer" >&2
  exit 1
fi

if [[ "$VERBOSE" != "true" && "$XIAOZHI_DOCKER_QUIET" == "true" && "$XIAOZHI_PROGRESS" == "true" && -t 1 ]]; then
  if [[ -z "$PARALLEL_RELEASE_STEPS_CONFIGURED" ]]; then
    PARALLEL_RELEASE_STEPS=false
  fi
  if [[ -z "$PARALLEL_IMAGE_BUILDS_CONFIGURED" ]]; then
    PARALLEL_IMAGE_BUILDS=false
  fi
fi

print_release_summary() {
  if is_quiet; then
    cat <<EOF
ACR release
  version:   $VERSION
  tags:      $CHANNEL_TAG, $IMAGE_VERSION_TAG
  images:    $(short_image_name "$SERVER_IMAGE_REPOSITORY:$IMAGE_VERSION_TAG")
  manager:   $(short_image_name "$MANAGER_API_IMAGE_REPOSITORY:$IMAGE_VERSION_TAG"), $(short_image_name "$MANAGER_WEB_IMAGE_REPOSITORY:$IMAGE_VERSION_TAG")
  assets:    $(short_image_name "$DEPLOY_ASSETS_IMAGE_REPOSITORY:$IMAGE_VERSION_TAG") contract=v$RELEASE_CONTRACT_VERSION
  runtime:   mysql:$MYSQL_TARGET_TAG, redis:$REDIS_TARGET_TAG
  options:   profile=$SERVER_INSTALL_PROFILE engine=$BUILD_ENGINE base=$BUILD_BASE seed_latest=$SERVER_BASE_SEED_LATEST runtime=$MIRROR_RUNTIME_IMAGES parallel=$PARALLEL_RELEASE_STEPS/$PARALLEL_IMAGE_BUILDS
  funasr:    local=$([[ "$SERVER_INSTALL_PROFILE" == "funasr" ]] && echo true || echo false) model=$INSTALL_FUNASR_MODEL
  output:    quiet progress=$XIAOZHI_PROGRESS interval=${XIAOZHI_PROGRESS_INTERVAL}s

EOF
    return
  fi

  cat <<EOF
Building and pushing xiaozhi images to Aliyun ACR.

Version:
  $VERSION

Image tags:
  channel=$CHANNEL_TAG version=$IMAGE_VERSION_TAG

Image repositories:
  server:      $SERVER_IMAGE_REPOSITORY
  manager-api: $MANAGER_API_IMAGE_REPOSITORY
  manager-web: $MANAGER_WEB_IMAGE_REPOSITORY
  deploy:      $DEPLOY_ASSETS_IMAGE_REPOSITORY
  base-common: $SERVER_COMMON_BASE_IMAGE_REPOSITORY
  base-lite:   $SERVER_LITE_BASE_IMAGE_REPOSITORY
  base-funasr: $SERVER_FUNASR_BASE_IMAGE_REPOSITORY
  mysql:       $MYSQL_IMAGE_REPOSITORY:$MYSQL_TARGET_TAG
  redis:       $REDIS_IMAGE_REPOSITORY:$REDIS_TARGET_TAG

Runtime image sources:
  mysql:       $MYSQL_SOURCE_IMAGE
  redis:       $REDIS_SOURCE_IMAGE

Default build engine:
  $BUILD_ENGINE

Build options:
  server_install_profile=$SERVER_INSTALL_PROFILE
  server_requirements=$SERVER_REQUIREMENTS
  server_requirements_funasr=${SERVER_REQUIREMENTS_FUNASR:-none}
  server_base_cache_version=$SERVER_BASE_CACHE_VERSION
  server_base_seed_latest=$SERVER_BASE_SEED_LATEST
  manager_api_cache_version=$MANAGER_API_CACHE_VERSION
  manager_web_cache_version=$MANAGER_WEB_CACHE_VERSION
  release_contract_version=$RELEASE_CONTRACT_VERSION
  release_assets_base_image=$RELEASE_ASSETS_BASE_IMAGE
  build_base=$BUILD_BASE server_base_image=${SERVER_BASE_IMAGE:-auto}
  mirror_runtime_images=$MIRROR_RUNTIME_IMAGES
  install_funasr_model=$INSTALL_FUNASR_MODEL
  funasr_model_local_path=${FUNASR_MODEL_LOCAL_PATH:-auto}
  funasr_model_context=${FUNASR_MODEL_CONTEXT:-auto}
  funasr_model_url=$FUNASR_MODEL_URL

Docker output:
  quiet=$XIAOZHI_DOCKER_QUIET verbose=$VERBOSE
  progress=$XIAOZHI_PROGRESS bar_interval=${XIAOZHI_PROGRESS_INTERVAL}s

Parallelism:
  release_steps=$PARALLEL_RELEASE_STEPS image_builds=$PARALLEL_IMAGE_BUILDS

This command still needs access to Docker build base images unless you override
PYTHON_BASE_IMAGE, NODE_BASE_IMAGE, MAVEN_BASE_IMAGE, API_RUNTIME_BASE_IMAGE,
and MANAGER_WEB_RUNTIME_BASE_IMAGE.
EOF
}

print_release_summary

mirror_runtime_images() {
  ACR_REGISTRY="$ACR_REGISTRY" \
    ACR_NAMESPACE="$ACR_NAMESPACE" \
    MYSQL_SOURCE_IMAGE="$MYSQL_SOURCE_IMAGE" \
    REDIS_SOURCE_IMAGE="$REDIS_SOURCE_IMAGE" \
    MYSQL_IMAGE_REPOSITORY="$MYSQL_IMAGE_REPOSITORY" \
    REDIS_IMAGE_REPOSITORY="$REDIS_IMAGE_REPOSITORY" \
    VERBOSE="$VERBOSE" \
    XIAOZHI_DOCKER_QUIET="$XIAOZHI_DOCKER_QUIET" \
    XIAOZHI_PROGRESS="$XIAOZHI_PROGRESS" \
    XIAOZHI_PROGRESS_INTERVAL="$XIAOZHI_PROGRESS_INTERVAL" \
    "$ROOT_DIR/scripts/acr-mirror-runtime-images"
}

should_mirror_runtime_images() {
  [[ "$PUSH" == "true" ]] || return 1

  if [[ "$MIRROR_RUNTIME_IMAGES" == "false" ]]; then
    return 1
  fi

  if [[ "$MIRROR_RUNTIME_IMAGES" == "true" ]]; then
    return 0
  fi

  local missing=false
  for image in "$MYSQL_IMAGE_REPOSITORY:$MYSQL_TARGET_TAG" "$REDIS_IMAGE_REPOSITORY:$REDIS_TARGET_TAG"; do
    if docker manifest inspect "$image" >/dev/null 2>&1; then
      if is_quiet; then
        echo "Runtime OK: $(short_image_name "$image")"
      else
        echo "Runtime image already exists in ACR: $image"
      fi
    else
      if is_quiet; then
        echo "Runtime mirror needed: $(short_image_name "$image")"
      else
        echo "Runtime image missing in ACR, will mirror: $image"
      fi
      missing=true
    fi
  done

  [[ "$missing" == "true" ]]
}

build_business_images() {
  SERVER_IMAGE_REPOSITORY="$SERVER_IMAGE_REPOSITORY" \
  MANAGER_API_IMAGE_REPOSITORY="$MANAGER_API_IMAGE_REPOSITORY" \
  MANAGER_WEB_IMAGE_REPOSITORY="$MANAGER_WEB_IMAGE_REPOSITORY" \
  SERVER_COMMON_BASE_IMAGE_REPOSITORY="$SERVER_COMMON_BASE_IMAGE_REPOSITORY" \
  SERVER_LITE_BASE_IMAGE_REPOSITORY="$SERVER_LITE_BASE_IMAGE_REPOSITORY" \
  SERVER_FUNASR_BASE_IMAGE_REPOSITORY="$SERVER_FUNASR_BASE_IMAGE_REPOSITORY" \
  SERVER_BASE_IMAGE_REPOSITORY="$SERVER_BASE_IMAGE_REPOSITORY" \
  BUILD_BASE="$BUILD_BASE" \
  SERVER_BASE_IMAGE="$SERVER_BASE_IMAGE" \
  BUILD_ENGINE="$BUILD_ENGINE" \
  PYTHON_BASE_IMAGE="$PYTHON_BASE_IMAGE" \
  NODE_BASE_IMAGE="$NODE_BASE_IMAGE" \
  MAVEN_BASE_IMAGE="$MAVEN_BASE_IMAGE" \
  WEB_RUNTIME_BASE_IMAGE="$WEB_RUNTIME_BASE_IMAGE" \
  API_RUNTIME_BASE_IMAGE="$API_RUNTIME_BASE_IMAGE" \
  MANAGER_WEB_RUNTIME_BASE_IMAGE="$MANAGER_WEB_RUNTIME_BASE_IMAGE" \
  SERVER_INSTALL_PROFILE="$SERVER_INSTALL_PROFILE" \
  SERVER_REQUIREMENTS="$SERVER_REQUIREMENTS" \
  SERVER_REQUIREMENTS_FUNASR="${SERVER_REQUIREMENTS_FUNASR:-}" \
  SERVER_BASE_CACHE_VERSION="$SERVER_BASE_CACHE_VERSION" \
  SERVER_BASE_SEED_LATEST="$SERVER_BASE_SEED_LATEST" \
  MANAGER_API_CACHE_VERSION="$MANAGER_API_CACHE_VERSION" \
  MANAGER_WEB_CACHE_VERSION="$MANAGER_WEB_CACHE_VERSION" \
  IMAGE_TAG_SUFFIX="$IMAGE_TAG_SUFFIX" \
  CHANNEL_TAG="$CHANNEL_TAG" \
  PUSH="$PUSH" \
  PLATFORMS="$PLATFORMS" \
  VERSION="$VERSION" \
  VERBOSE="$VERBOSE" \
  XIAOZHI_DOCKER_QUIET="$XIAOZHI_DOCKER_QUIET" \
  XIAOZHI_PROGRESS="$XIAOZHI_PROGRESS" \
  XIAOZHI_PROGRESS_INTERVAL="$XIAOZHI_PROGRESS_INTERVAL" \
  INSTALL_FUNASR_MODEL="$INSTALL_FUNASR_MODEL" \
  FUNASR_MODEL_URL="$FUNASR_MODEL_URL" \
  FUNASR_MODEL_LOCAL_PATH="$FUNASR_MODEL_LOCAL_PATH" \
  FUNASR_MODEL_CONTEXT="$FUNASR_MODEL_CONTEXT" \
  PARALLEL_IMAGE_BUILDS="$PARALLEL_IMAGE_BUILDS" \
  PRINT_BUILD_CONFIG="$([[ "$PRINT_BUILD_CONFIG_ONLY" == "true" ]] && printf true || printf false)" \
  PRINT_BUILD_CONFIG_ONLY="$PRINT_BUILD_CONFIG_ONLY" \
  bash "$ROOT_DIR/scripts/docker-build-private.sh"
}

build_release_assets_image() {
  local version_image="$DEPLOY_ASSETS_IMAGE_REPOSITORY:$IMAGE_VERSION_TAG"
  local channel_image="$DEPLOY_ASSETS_IMAGE_REPOSITORY:$CHANNEL_TAG"
  local quiet_args=()
  if is_quiet; then
    quiet_args=(--quiet)
  fi
  local common_args=(
    --build-arg "RELEASE_ASSETS_BASE_IMAGE=$RELEASE_ASSETS_BASE_IMAGE"
    --build-arg "RELEASE_VERSION=$IMAGE_VERSION_TAG"
    --build-arg "RELEASE_SOURCE_COMMIT=$SOURCE_COMMIT"
    --build-arg "RELEASE_CONTRACT_VERSION=$RELEASE_CONTRACT_VERSION"
    --build-arg "SERVER_IMAGE_REPOSITORY=$SERVER_IMAGE_REPOSITORY"
    --build-arg "MANAGER_API_IMAGE_REPOSITORY=$MANAGER_API_IMAGE_REPOSITORY"
    --build-arg "MANAGER_WEB_IMAGE_REPOSITORY=$MANAGER_WEB_IMAGE_REPOSITORY"
    --build-arg "MYSQL_IMAGE=$MYSQL_IMAGE_REPOSITORY:$MYSQL_TARGET_TAG"
    --build-arg "REDIS_IMAGE=$REDIS_IMAGE_REPOSITORY:$REDIS_TARGET_TAG"
    -f "$ROOT_DIR/deploy/production/Dockerfile.release-assets"
    -t "$version_image"
    -t "$channel_image"
  )

  if [[ "$BUILD_ENGINE" == "buildx" ]]; then
    local output_args=(--load)
    if [[ "$PUSH" == "true" ]]; then
      output_args=(--push)
    elif [[ "$PLATFORMS" == *,* ]]; then
      echo "PUSH=false cannot load a multi-platform release-assets image; choose one platform." >&2
      return 1
    fi
    docker buildx build "${quiet_args[@]}" --platform "$PLATFORMS" "${output_args[@]}" \
      "${common_args[@]}" "$ROOT_DIR"
    if is_quiet; then
      echo "Release assets OK: $(short_image_name "$version_image")"
    fi
    return
  fi

  docker build "${quiet_args[@]}" "${common_args[@]}" "$ROOT_DIR"
  if [[ "$PUSH" == "true" ]]; then
    docker push "${quiet_args[@]}" "$version_image"
    if [[ "$channel_image" != "$version_image" ]]; then
      docker push "${quiet_args[@]}" "$channel_image"
    fi
  fi
  if is_quiet; then
    echo "Release assets OK: $(short_image_name "$version_image")"
  fi
}

wait_for_release_step() {
  local label="$1"
  local pid="$2"

  if wait "$pid"; then
    echo "$label step OK"
    return 0
  fi
  echo "$label step FAILED" >&2
  return 1
}

RUNTIME_MIRROR_NEEDED=false
if [[ "$PRINT_BUILD_CONFIG_ONLY" != "true" ]] && should_mirror_runtime_images; then
  RUNTIME_MIRROR_NEEDED=true
fi

if [[ "$RUNTIME_MIRROR_NEEDED" == "true" && "$PARALLEL_RELEASE_STEPS" == "true" ]]; then
  mirror_runtime_images &
  MIRROR_PID=$!
  build_business_images &
  BUILD_PID=$!

  RELEASE_STATUS=0
  wait_for_release_step "Runtime image mirror" "$MIRROR_PID" || RELEASE_STATUS=1
  wait_for_release_step "Business image build" "$BUILD_PID" || RELEASE_STATUS=1
  if [[ "$RELEASE_STATUS" -ne 0 ]]; then
    exit "$RELEASE_STATUS"
  fi
else
  if [[ "$RUNTIME_MIRROR_NEEDED" == "true" ]]; then
    mirror_runtime_images
  fi

  build_business_images
fi

if [[ "$PRINT_BUILD_CONFIG_ONLY" == "true" ]]; then
  echo ""
  echo "=== Build config only ==="
  echo "No images were built, pushed, retagged, or pruned."
  echo ""
  exit 0
fi

build_release_assets_image

echo ""
echo "=== Build complete ==="
echo "Version: $VERSION"
echo "Image tags: $CHANNEL_TAG, $IMAGE_VERSION_TAG"
echo "Release assets: $DEPLOY_ASSETS_IMAGE_REPOSITORY:$IMAGE_VERSION_TAG"
echo "Deploy channel: VERSION=$CHANNEL_TAG ~/xiaozhi-upgrade"
echo "Deploy pinned: VERSION=$IMAGE_VERSION_TAG ~/xiaozhi-upgrade"
echo ""
