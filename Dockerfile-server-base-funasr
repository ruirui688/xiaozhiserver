ARG SERVER_LITE_BASE_IMAGE=xiaozhi-server-base-lite-local:latest
FROM ${SERVER_LITE_BASE_IMAGE}

ARG SERVER_REQUIREMENTS_FUNASR=main/xiaozhi-server/requirements-docker-funasr-extra.txt
ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

USER root
WORKDIR /opt/xiaozhi-esp32-server

COPY ${SERVER_REQUIREMENTS_FUNASR} requirements-funasr-extra.txt

RUN if [ -n "$PYTORCH_INDEX_URL" ]; then \
      sed -i "s#^--extra-index-url https://download.pytorch.org/whl/cpu#--extra-index-url ${PYTORCH_INDEX_URL}#" requirements-funasr-extra.txt; \
    fi

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-funasr-extra.txt --default-timeout=120 --retries 5 && \
    chown -R xiaozhi:xiaozhi /opt/xiaozhi-esp32-server

USER xiaozhi
